{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "method",
    "target_strategy",
    "tools",
    "interface",
    "color_alpha",
    "limitations"
  ],
  "properties": {
    "version": {
      "const": "case3-resolve-green-v3.1-draft"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "target_strategy": {
      "type": "string",
      "minLength": 1
    },
    "color_alpha": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "interface": {
      "enum": [
        "API",
        "GUI",
        "mixed"
      ]
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
