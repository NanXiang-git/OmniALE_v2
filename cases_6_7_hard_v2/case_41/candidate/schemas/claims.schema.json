{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "visible_or_audible",
              "character_claim",
              "interpretation"
            ]
          },
          "output": {
            "type": "object",
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "start",
              "end"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "start",
                "end"
              ]
            },
            "minItems": 1,
            "maxItems": 4
          }
        },
        "required": [
          "id",
          "text",
          "kind",
          "output",
          "evidence"
        ]
      },
      "minItems": 15,
      "maxItems": 60
    }
  },
  "required": [
    "claims"
  ]
}