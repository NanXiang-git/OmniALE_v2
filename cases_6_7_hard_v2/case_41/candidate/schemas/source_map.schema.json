{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "type": "object",
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "start",
              "end"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "start",
              "end"
            ]
          },
          "fact": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "output",
          "source",
          "fact"
        ]
      },
      "minItems": 40,
      "maxItems": 90
    },
    "narration_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "start",
          "end",
          "text"
        ]
      },
      "minItems": 1
    },
    "protected_audio": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "start",
          "end"
        ]
      },
      "minItems": 4,
      "maxItems": 6
    },
    "causal_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cause": {
            "type": "object",
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "start",
              "end"
            ]
          },
          "effect": {
            "type": "object",
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "start",
              "end"
            ]
          },
          "output": {
            "type": "object",
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "start",
              "end"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "cause",
          "effect",
          "output",
          "claim"
        ]
      },
      "minItems": 3,
      "maxItems": 8
    }
  },
  "required": [
    "segments",
    "narration_regions",
    "protected_audio",
    "causal_links"
  ]
}