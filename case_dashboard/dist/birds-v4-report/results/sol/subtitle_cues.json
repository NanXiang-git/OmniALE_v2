[
  {
    "start": 6.268,
    "end": 9.512,
    "text": "这只小鸟，我判断是四川短翅莺。",
    "segment": 1
  },
  {
    "start": 12.568,
    "end": 15.601,
    "text": "看它暖褐色的背部、深色细嘴，",
    "segment": 1
  },
  {
    "start": 15.739,
    "end": 17.706,
    "text": "还有向后伸出的长尾。",
    "segment": 1
  },
  {
    "start": 28.068,
    "end": 30.825,
    "text": "原声里的短音有节奏地重复，",
    "segment": 1
  },
  {
    "start": 30.923,
    "end": 32.706,
    "text": "像一串简短的鸣唱。",
    "segment": 1
  },
  {
    "start": 35.268,
    "end": 38.327,
    "text": "不过，画面没有同步的张嘴动作，",
    "segment": 1
  },
  {
    "start": 38.439,
    "end": 40.446,
    "text": "声音归属仍需谨慎。",
    "segment": 1
  },
  {
    "start": 50.068,
    "end": 51.706,
    "text": "枝叶把鸟遮住了。",
    "segment": 2
  },
  {
    "start": 52.136,
    "end": 54.143,
    "text": "根据成串重复的鸣唱，",
    "segment": 2
  },
  {
    "start": 54.254,
    "end": 56.696,
    "text": "我暂按四川短翅莺识别。",
    "segment": 2
  },
  {
    "start": 62.068,
    "end": 63.851,
    "text": "声音一阵接着一阵，",
    "segment": 2
  },
  {
    "start": 64.054,
    "end": 66.206,
    "text": "鸟却藏在浓密的枝叶后。",
    "segment": 2
  },
  {
    "start": 79.068,
    "end": 82.022,
    "text": "这只鸟，我判断是桤木纹霸鹟。",
    "segment": 3
  },
  {
    "start": 84.068,
    "end": 87.246,
    "text": "浅色喉部、淡眼圈和两道翼斑，",
    "segment": 3
  },
  {
    "start": 87.304,
    "end": 88.588,
    "text": "是主要线索。",
    "segment": 3
  },
  {
    "start": 92.068,
    "end": 93.956,
    "text": "它在枝头抬头鸣唱，",
    "segment": 3
  },
  {
    "start": 94.081,
    "end": 95.983,
    "text": "短句之间留着停顿。",
    "segment": 3
  },
  {
    "start": 107.068,
    "end": 108.798,
    "text": "芦苇后的这只小鸟，",
    "segment": 4
  },
  {
    "start": 108.897,
    "end": 110.601,
    "text": "暂按芦苇莺识别。",
    "segment": 4
  },
  {
    "start": 113.068,
    "end": 115.509,
    "text": "画面失焦，细节看不清。",
    "segment": 4
  },
  {
    "start": 118.068,
    "end": 121.693,
    "text": "原声中，短小多变的鸣唱接连出现。",
    "segment": 4
  },
  {
    "start": 130.068,
    "end": 131.719,
    "text": "这是黑脚信天翁。",
    "segment": 5
  },
  {
    "start": 132.149,
    "end": 133.696,
    "text": "深褐色的成鸟，",
    "segment": 5
  },
  {
    "start": 133.82,
    "end": 136.209,
    "text": "正靠近全身绒羽的雏鸟。",
    "segment": 5
  },
  {
    "start": 140.068,
    "end": 143.522,
    "text": "成鸟俯身，和雏鸟嘴对嘴地接触。",
    "segment": 5
  },
  {
    "start": 143.965,
    "end": 146.433,
    "text": "信天翁会把食物反刍出来，",
    "segment": 5
  },
  {
    "start": 146.504,
    "end": 147.512,
    "text": "喂给幼鸟。",
    "segment": 5
  },
  {
    "start": 153.068,
    "end": 155.877,
    "text": "原声里，还夹着尖细的叫声。",
    "segment": 5
  },
  {
    "start": 163.068,
    "end": 164.772,
    "text": "这是黑背信天翁。",
    "segment": 6
  },
  {
    "start": 165.202,
    "end": 167.485,
    "text": "白头白腹，背翼深黑。",
    "segment": 6
  },
  {
    "start": 173.068,
    "end": 176.614,
    "text": "仰头长鸣、相互碰嘴，配合点头，",
    "segment": 6
  },
  {
    "start": 176.752,
    "end": 178.562,
    "text": "这是它们的求偶展示。",
    "segment": 6
  }
]