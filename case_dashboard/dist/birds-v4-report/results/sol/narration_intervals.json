[
  {
    "id": "s1a",
    "segment": 1,
    "start": 6.2,
    "end": 9.992,
    "speech_start": 6.302625,
    "speech_end": 9.381583,
    "text": "这只小鸟，我判断是四川短翅莺。"
  },
  {
    "id": "s1b",
    "segment": 1,
    "start": 12.5,
    "end": 18.188,
    "speech_start": 12.602625,
    "speech_end": 17.576291,
    "text": "看它暖褐色的背部、深色细嘴，还有向后伸出的长尾。"
  },
  {
    "id": "s1c",
    "segment": 1,
    "start": 28.0,
    "end": 33.184,
    "speech_start": 28.102625,
    "speech_end": 32.576291,
    "text": "原声里的短音有节奏地重复，像一串简短的鸣唱。"
  },
  {
    "id": "s1d",
    "segment": 1,
    "start": 35.2,
    "end": 40.936,
    "speech_start": 35.302625,
    "speech_end": 40.315791,
    "text": "不过，画面没有同步的张嘴动作，声音归属仍需谨慎。"
  },
  {
    "id": "s2a",
    "segment": 2,
    "start": 50.0,
    "end": 57.176,
    "speech_start": 50.102625,
    "speech_end": 56.565791,
    "text": "枝叶把鸟遮住了。根据成串重复的鸣唱，我暂按四川短翅莺识别。"
  },
  {
    "id": "s2b",
    "segment": 2,
    "start": 62.0,
    "end": 66.68,
    "speech_start": 62.102625,
    "speech_end": 66.076291,
    "text": "声音一阵接着一阵，鸟却藏在浓密的枝叶后。"
  },
  {
    "id": "s3a",
    "segment": 3,
    "start": 79.0,
    "end": 82.504,
    "speech_start": 79.102625,
    "speech_end": 81.892082,
    "text": "这只鸟，我判断是桤木纹霸鹟。"
  },
  {
    "id": "s3b",
    "segment": 3,
    "start": 84.0,
    "end": 89.064,
    "speech_start": 84.102625,
    "speech_end": 88.457916,
    "text": "浅色喉部、淡眼圈和两道翼斑，是主要线索。"
  },
  {
    "id": "s3c",
    "segment": 3,
    "start": 92.0,
    "end": 96.464,
    "speech_start": 92.102625,
    "speech_end": 95.852666,
    "text": "它在枝头抬头鸣唱，短句之间留着停顿。"
  },
  {
    "id": "s4a",
    "segment": 4,
    "start": 107.0,
    "end": 111.08,
    "speech_start": 107.102625,
    "speech_end": 110.471041,
    "text": "芦苇后的这只小鸟，暂按芦苇莺识别。"
  },
  {
    "id": "s4b",
    "segment": 4,
    "start": 113.0,
    "end": 115.976,
    "speech_start": 113.102625,
    "speech_end": 115.378916,
    "text": "画面失焦，细节看不清。"
  },
  {
    "id": "s4c",
    "segment": 4,
    "start": 118.0,
    "end": 122.176,
    "speech_start": 118.102625,
    "speech_end": 121.563166,
    "text": "原声中，短小多变的鸣唱接连出现。"
  },
  {
    "id": "s5a",
    "segment": 5,
    "start": 130.0,
    "end": 136.696,
    "speech_start": 130.102625,
    "speech_end": 136.078958,
    "text": "这是黑脚信天翁。深褐色的成鸟，正靠近全身绒羽的雏鸟。"
  },
  {
    "id": "s5b",
    "segment": 5,
    "start": 140.0,
    "end": 147.992,
    "speech_start": 140.102625,
    "speech_end": 147.381583,
    "text": "成鸟俯身，和雏鸟嘴对嘴地接触。信天翁会把食物反刍出来，喂给幼鸟。"
  },
  {
    "id": "s5c",
    "segment": 5,
    "start": 153.0,
    "end": 156.36,
    "speech_start": 153.102625,
    "speech_end": 155.747375,
    "text": "原声里，还夹着尖细的叫声。"
  },
  {
    "id": "s6a",
    "segment": 6,
    "start": 163.0,
    "end": 167.944,
    "speech_start": 163.102625,
    "speech_end": 167.35525,
    "text": "这是黑背信天翁。白头白腹，背翼深黑。"
  },
  {
    "id": "s6b",
    "segment": 6,
    "start": 173.0,
    "end": 179.048,
    "speech_start": 173.102625,
    "speech_end": 178.431583,
    "text": "仰头长鸣、相互碰嘴，配合点头，这是它们的求偶展示。"
  }
]