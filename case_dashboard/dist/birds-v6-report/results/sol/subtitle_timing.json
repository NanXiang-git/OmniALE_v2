[
  {
    "start": 4.604,
    "end": 6.494,
    "text": "这只棕褐色的小鸟",
    "utterance": "s1a"
  },
  {
    "start": 6.574,
    "end": 7.92,
    "text": "是宽尾树莺",
    "utterance": "s1a"
  },
  {
    "start": 10.604,
    "end": 13.268,
    "text": "短而圆的翅膀、较长的宽尾",
    "utterance": "s1b"
  },
  {
    "start": 13.417,
    "end": 14.953,
    "text": "还有浅色的喉部",
    "utterance": "s1b"
  },
  {
    "start": 15.034,
    "end": 16.57,
    "text": "都是观察线索",
    "utterance": "s1b"
  },
  {
    "start": 26.104,
    "end": 30.765,
    "text": "原声中，低一些的短叫和更尖的音节先后出现",
    "utterance": "s1c"
  },
  {
    "start": 30.914,
    "end": 32.396,
    "text": "节奏也有变化",
    "utterance": "s1c"
  },
  {
    "start": 36.104,
    "end": 38.333,
    "text": "画面没有显示开口动作",
    "utterance": "s1d"
  },
  {
    "start": 38.496,
    "end": 41.445,
    "text": "不能把每一声都确定归给这只鸟",
    "utterance": "s1d"
  },
  {
    "start": 50.104,
    "end": 51.762,
    "text": "灌丛里这组短叫",
    "utterance": "s2a"
  },
  {
    "start": 51.925,
    "end": 55.377,
    "text": "暂按新疆歌鸲，也就是夜莺来判断",
    "utterance": "s2a"
  },
  {
    "start": 62.104,
    "end": 65.053,
    "text": "这种重复的短声更像警戒叫",
    "utterance": "s2b"
  },
  {
    "start": 65.519,
    "end": 67.204,
    "text": "鸟体被枝叶遮住",
    "utterance": "s2b"
  },
  {
    "start": 67.353,
    "end": 69.188,
    "text": "具体动作还看不清",
    "utterance": "s2b"
  },
  {
    "start": 78.104,
    "end": 80.428,
    "text": "枝头这只是桤木纹霸鹟",
    "utterance": "s3a"
  },
  {
    "start": 80.908,
    "end": 83.286,
    "text": "灰橄榄色上体，白喉",
    "utterance": "s3a"
  },
  {
    "start": 83.394,
    "end": 85.501,
    "text": "翅上还有两道浅色翼斑",
    "utterance": "s3a"
  },
  {
    "start": 91.104,
    "end": 93.754,
    "text": "它抬头张嘴，重复短促",
    "utterance": "s3b"
  },
  {
    "start": 93.795,
    "end": 95.453,
    "text": "带沙哑感的声句",
    "utterance": "s3b"
  },
  {
    "start": 95.932,
    "end": 98.99,
    "text": "相似的霸鹟，常要靠声音区分",
    "utterance": "s3b"
  },
  {
    "start": 105.104,
    "end": 108.135,
    "text": "这里暂按长嘴沼泽鹪鹩判断",
    "utterance": "s4a"
  },
  {
    "start": 112.104,
    "end": 113.926,
    "text": "短音与颤音交替",
    "utterance": "s4b"
  },
  {
    "start": 114.047,
    "end": 116.127,
    "text": "像一串串急促的轻响",
    "utterance": "s4b"
  },
  {
    "start": 116.606,
    "end": 119.65,
    "text": "鸟体被遮挡，具体动作看不清",
    "utterance": "s4b"
  },
  {
    "start": 127.504,
    "end": 129.543,
    "text": "这只绒羽蓬松的雏鸟",
    "utterance": "s5a"
  },
  {
    "start": 129.638,
    "end": 131.173,
    "text": "是黑脚信天翁",
    "utterance": "s5a"
  },
  {
    "start": 138.604,
    "end": 141.934,
    "text": "成鸟全身深褐，嘴基周围泛白",
    "utterance": "s5b"
  },
  {
    "start": 142.413,
    "end": 144.452,
    "text": "雏鸟把嘴凑向成鸟",
    "utterance": "s5b"
  },
  {
    "start": 144.56,
    "end": 146.272,
    "text": "成鸟也俯下头",
    "utterance": "s5b"
  },
  {
    "start": 149.104,
    "end": 152.583,
    "text": "这是信天翁亲鸟喂食时常见的姿势",
    "utterance": "s5c"
  },
  {
    "start": 152.786,
    "end": 154.974,
    "text": "食物本身并不容易看清",
    "utterance": "s5c"
  },
  {
    "start": 162.104,
    "end": 164.048,
    "text": "这些白头、白腹",
    "utterance": "s6a"
  },
  {
    "start": 164.142,
    "end": 166.996,
    "text": "黑色背翼的，是黑背信天翁",
    "utterance": "s6a"
  },
  {
    "start": 172.104,
    "end": 173.844,
    "text": "两只鸟相向站立",
    "utterance": "s6b"
  },
  {
    "start": 173.939,
    "end": 176.806,
    "text": "摆头、低头，又互相触喙",
    "utterance": "s6b"
  },
  {
    "start": 177.272,
    "end": 179.215,
    "text": "这是它们的求偶展示",
    "utterance": "s6b"
  },
  {
    "start": 180.604,
    "end": 182.657,
    "text": "鸣叫和急促的喙击声",
    "utterance": "s6c"
  },
  {
    "start": 182.751,
    "end": 184.355,
    "text": "配合着这些动作",
    "utterance": "s6c"
  }
]