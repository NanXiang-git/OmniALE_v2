[
 {"id":"s1a","segment":1,"start":4.5,"latest_end":9.8,"text":"这只棕褐色的小鸟，是宽尾树莺。"},
 {"id":"s1b","segment":1,"start":10.5,"latest_end":19.0,"text":"短而圆的翅膀、较长的宽尾，还有浅色的喉部，都是观察线索。"},
 {"id":"s1c","segment":1,"start":26.0,"latest_end":35.0,"text":"原声中，低一些的短叫和更尖的音节先后出现，节奏也有变化。"},
 {"id":"s1d","segment":1,"start":36.0,"latest_end":45.7,"text":"画面没有显示开口动作，不能把每一声都确定归给这只鸟。"},
 {"id":"s2a","segment":2,"start":50.0,"latest_end":58.8,"text":"灌丛里这组短叫，暂按新疆歌鸲，也就是夜莺来判断。"},
 {"id":"s2b","segment":2,"start":62.0,"latest_end":72.5,"text":"这种重复的短声更像警戒叫。鸟体被枝叶遮住，具体动作还看不清。"},
 {"id":"s3a","segment":3,"start":78.0,"latest_end":88.5,"text":"枝头这只是桤木纹霸鹟。灰橄榄色上体，白喉，翅上还有两道浅色翼斑。"},
 {"id":"s3b","segment":3,"start":91.0,"latest_end":100.5,"text":"它抬头张嘴，重复短促、带沙哑感的声句。相似的霸鹟，常要靠声音区分。"},
 {"id":"s4a","segment":4,"start":105.0,"latest_end":110.0,"text":"这里暂按长嘴沼泽鹪鹩判断。"},
 {"id":"s4b","segment":4,"start":112.0,"latest_end":123.4,"text":"短音与颤音交替，像一串串急促的轻响。鸟体被遮挡，具体动作看不清。"},
 {"id":"s5a","segment":5,"start":127.4,"latest_end":132.5,"text":"这只绒羽蓬松的雏鸟，是黑脚信天翁。"},
 {"id":"s5b","segment":5,"start":138.5,"latest_end":147.8,"text":"成鸟全身深褐，嘴基周围泛白。雏鸟把嘴凑向成鸟，成鸟也俯下头。"},
 {"id":"s5c","segment":5,"start":149.0,"latest_end":158.1,"text":"这是信天翁亲鸟喂食时常见的姿势，食物本身并不容易看清。"},
 {"id":"s6a","segment":6,"start":162.0,"latest_end":168.5,"text":"这些白头、白腹、黑色背翼的，是黑背信天翁。"},
 {"id":"s6b","segment":6,"start":172.0,"latest_end":180.2,"text":"两只鸟相向站立，摆头、低头，又互相触喙。这是它们的求偶展示。"},
 {"id":"s6c","segment":6,"start":180.5,"latest_end":185.3,"text":"鸣叫和急促的喙击声，配合着这些动作。"}
]
