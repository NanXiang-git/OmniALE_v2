{
  "cues": [
    {
      "id": "AD01",
      "start": 1.24,
      "end": 3.34,
      "text": "黄酱从红蘑菇上滴落。",
      "wav": "cues/AD01.wav",
      "visual_source_interval": [
        0.0,
        0.917
      ],
      "knowledge_time": 0.583,
      "visual_evidence": "营地草地上，黄色团块从带白点的红蘑菇上落下。黄色物体按外观称为黄酱。"
    },
    {
      "id": "AD02",
      "start": 4.43,
      "end": 6.934,
      "text": "帐篷边，马尾女孩盯着蘑菇。",
      "wav": "cues/AD02.wav",
      "visual_source_interval": [
        0.917,
        4.958
      ],
      "knowledge_time": 2.5,
      "visual_evidence": "马尾女孩扶着帐篷，朝地上的红蘑菇看。"
    },
    {
      "id": "AD03",
      "start": 11.28,
      "end": 13.763,
      "text": "蘑菇帽下伸出绿色的手脚。",
      "wav": "cues/AD03.wav",
      "visual_source_interval": [
        9.333,
        14.25
      ],
      "knowledge_time": 11.25,
      "visual_evidence": "原先像一朵蘑菇的红帽抬起来，底下露出小小的绿色手脚。"
    },
    {
      "id": "AD04",
      "start": 14.58,
      "end": 17.817,
      "text": "小精灵从人脚边跑开，穿过一地垃圾。",
      "wav": "cues/AD04.wav",
      "visual_source_interval": [
        14.25,
        17.708
      ],
      "knowledge_time": 14.333,
      "visual_evidence": "这只小精灵从成人脚边跑开，沿途经过包装袋和罐头。"
    },
    {
      "id": "AD05",
      "start": 20.7,
      "end": 23.119,
      "text": "它和另外两只钻进灌木丛。",
      "wav": "cues/AD05.wav",
      "visual_source_interval": [
        17.708,
        21.708
      ],
      "knowledge_time": 20.667,
      "visual_evidence": "又跑来两只小精灵。三只汇合，从同一片灌木底下钻进去。"
    },
    {
      "id": "AD06",
      "start": 24.6,
      "end": 27.211,
      "text": "女孩伏低身子，朝灌木爬去。",
      "wav": "cues/AD06.wav",
      "visual_source_interval": [
        24.458,
        27.375
      ],
      "knowledge_time": 24.542,
      "visual_evidence": "马尾女孩压低身体，朝精灵消失的灌木爬。"
    },
    {
      "id": "AD07",
      "start": 28.785,
      "end": 30.305,
      "text": "她从叶下探头。",
      "wav": "cues/AD07.wav",
      "visual_source_interval": [
        27.375,
        30.292
      ],
      "knowledge_time": 28.417,
      "visual_evidence": "女孩从灌木另一侧探头，前景掠过精灵的红帽。"
    },
    {
      "id": "AD08",
      "start": 30.4,
      "end": 32.291,
      "text": "树下满是红帽精灵。",
      "wav": "cues/AD08.wav",
      "visual_source_interval": [
        30.292,
        33.375
      ],
      "knowledge_time": 30.292,
      "visual_evidence": "女孩面前豁然展开树林空地，树干上有洞口，许多红帽绿身的精灵在树下活动。"
    },
    {
      "id": "AD09",
      "start": 40.18,
      "end": 42.872,
      "text": "她拿本子记录，四个同伴走过来。",
      "wav": "cues/AD09.wav",
      "visual_source_interval": [
        33.375,
        39.917
      ],
      "knowledge_time": 38.25,
      "visual_evidence": "女孩先取出本子记录。四个同伴陆续站在她身边，也看向空地。"
    },
    {
      "id": "AD10",
      "start": 42.99,
      "end": 45.241,
      "text": "精灵拿黄花给瓢虫刷背。",
      "wav": "cues/AD10.wav",
      "visual_source_interval": [
        39.917,
        43.875
      ],
      "knowledge_time": 40.0,
      "visual_evidence": "三只精灵并排，用黄色花朵刷瓢虫的背。还有瓢虫排在前方。"
    },
    {
      "id": "AD11",
      "start": 47.28,
      "end": 49.729,
      "text": "精灵用叶子给蝴蝶补翅膀。",
      "wav": "cues/AD11.wav",
      "visual_source_interval": [
        43.875,
        48.417
      ],
      "knowledge_time": 47.25,
      "visual_evidence": "一只精灵捡起叶片，把叶片插在蝴蝶翅膀旁，蝴蝶随即飞起来。"
    },
    {
      "id": "AD12",
      "start": 49.86,
      "end": 51.577,
      "text": "精灵给蜘蛛做急救。",
      "wav": "cues/AD12.wav",
      "visual_source_interval": [
        48.417,
        52.625
      ],
      "knowledge_time": 49.25,
      "visual_evidence": "三个精灵围着瘫倒的蓝蜘蛛，中间一只按压，随后低头贴近蜘蛛。"
    },
    {
      "id": "AD13",
      "start": 52.19,
      "end": 53.35,
      "text": "蜘蛛站稳了。",
      "wav": "cues/AD13.wav",
      "visual_source_interval": [
        51.625,
        53.583
      ],
      "knowledge_time": 52.167,
      "visual_evidence": "蜘蛛翻过来，八脚撑起身子。精灵们随后张开双臂。"
    },
    {
      "id": "AD14",
      "start": 77.0,
      "end": 78.798,
      "text": "白胡子精灵翻出树洞。",
      "wav": "cues/AD14.wav",
      "visual_source_interval": [
        73.417,
        78.25
      ],
      "knowledge_time": 76.875,
      "visual_evidence": "白胡子精灵在高处的圆树洞里现身。打过招呼后从洞口翻出，沿树向下。"
    },
    {
      "id": "AD15",
