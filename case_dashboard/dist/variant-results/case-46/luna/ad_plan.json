    },
    {
      "id": "AD02",
      "start": 4.55,
      "end": 6.187021,
      "text": "蘑菇忽然蹦开。",
      "wav": "cues/AD02.wav",
      "visual_source_interval": [4.0, 6.3],
      "knowledge_time": 5.0
    },
    {
      "id": "AD03",
      "start": 9.1,
      "end": 11.81675,
      "text": "女孩跟着红点蘑菇，走出营地。",
      "wav": "cues/AD03.wav",
      "visual_source_interval": [9.0, 13.0],
      "knowledge_time": 9.0
    },
    {
      "id": "AD04",
      "start": 13.8,
      "end": 16.539958,
      "text": "小蘑菇蹦过草地，钻进林间。",
      "wav": "cues/AD04.wav",
      "visual_source_interval": [13.0, 18.0],
      "knowledge_time": 13.0
    },
    {
      "id": "AD05",
      "start": 18.35,
      "end": 20.915813,
      "text": "女孩伏低身子，悄悄跟着它。",
      "wav": "cues/AD05.wav",
      "visual_source_interval": [18.0, 22.0],
      "knowledge_time": 18.0
    },
    {
      "id": "AD06",
      "start": 28.85,
      "end": 31.845375,
      "text": "空地上，红帽小精灵成群聚集。",
      "wav": "cues/AD06.wav",
      "visual_source_interval": [28.0, 32.3],
      "knowledge_time": 28.0
    },
    {
      "id": "AD07",
      "start": 40.25,
      "end": 42.746146,
      "text": "露营者们也来到林间空地。",
