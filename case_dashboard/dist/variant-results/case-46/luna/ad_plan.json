      "visual_source_interval": [40.0, 43.0],
      "knowledge_time": 40.0
    },
    {
      "id": "AD08",
      "start": 43.2,
      "end": 46.741063,
      "text": "三只红帽精灵并排，瓢虫从前面经过。",
