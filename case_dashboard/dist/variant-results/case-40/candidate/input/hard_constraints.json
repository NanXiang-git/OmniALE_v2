  "audio_contract": {
    "sample_rate": 48000,
    "stereo_tracks": [
      "mix.wav",
      "effects_track.wav",
      "all speaker wav files"
    ],
    "mono_tracks": [
      "mobile_mix.wav"
    ],
    "duration_tolerance_seconds": 0.08,
    "effects_gain_db_range": [
      -12,
      0
    ],
    "effects_formula": "effects_track = input/music_effects.wav * 10 ** (effects_gain_db / 20); no shifting, ducking, EQ, splicing, time stretching, or replacement",
    "mix_formula": "mix.wav = effects_track.wav + sum(all final-gain speaker tracks); no post-sum processing",
    "maximum_relative_waveform_error": 0.02,
    "cinema_integrated_lufs": [
      -17,
      -15
    ],
    "cinema_true_peak_max_dbtp": -1,
    "mobile_integrated_lufs": [
      -19,
      -17
    ],
    "mobile_true_peak_max_dbtp": -2,
    "mobile_formula": "0.5*(mix.left+mix.right), followed only by declared global gain and peak limiter; no content edits",
    "mobile_ffmpeg_filter": "pan=mono|c0=0.5*c0+0.5*c1,volume={gain_db}dB,alimiter=limit=0.7943282347:attack=5:release=50:level=0:latency=1"
  },
  "subtitle_contract": {
    "max_lines_per_language": 2,
    "zh_max_chars_per_line": 18,
    "en_max_chars_per_line": 42,
    "max_zh_chars_per_second": 10,
    "regular_min_duration": 0.4,
    "max_duration": 7,
    "screen_text_may_overlap_speech": true,
    "note": "Unicode non-whitespace code points; punctuation counts; speech cues must intersect corresponding plan event. Very short original interjections may last 0.2-0.4 s if source duration is similarly short and documented.",
    "burn_in_required": true,
    "burn_in_region": "bottom 32 percent of frame; both ZH and EN visible"
  },
  "reference_policy": "S001–S062 标记不同源事件，粗时间只供检索。字幕上同一个编号如包含多位发言者须拆分；非语言角色叫声和背景声按真实声源处理。",
  "delivery_budget": {
    "suggested_minutes": 180,
    "cpu_cores": 8,
    "ram_gb": 32,
    "optional_gpu_gb": 24,
    "workspace_gb": 30
  },
  "minimum_roles": 4
}
