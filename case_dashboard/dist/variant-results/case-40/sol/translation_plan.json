{
  "events": [
    {
      "event_id": "E001",
      "source_ids": [
        "S001"
      ],
      "type": "speech",
      "speaker_id": "harald",
      "speaker_instance": "harald_greenhouse",
      "voice_id": "harald_f5",
      "source_text": "Den blommar på natten.",
      "zh_text": "它呀，夜里才开花。",
      "start": 1.06,
      "end": 3.3,
      "visible_speech": true,
      "delivery_note": "低声指出眼前的花，平静。"
    },
    {
      "event_id": "E002",
      "source_ids": [
        "S002"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Jag ser inga blommor.",
      "zh_text": "我没看见花啊。",
      "start": 5.83,
      "end": 7.42,
      "visible_speech": true,
      "delivery_note": "低头找花，轻声说出观察。"
    },
    {
      "event_id": "E003",
      "source_ids": [
        "S003",
        "S004"
      ],
      "type": "speech",
      "speaker_id": "harald",
      "speaker_instance": "harald_greenhouse",
      "voice_id": "harald_f5",
      "source_text": "Det tar tio år.",
      "zh_text": "得等上十年。",
      "start": 7.98,
      "end": 9.66,
      "visible_speech": true,
      "delivery_note": "朴素直说，重音落在十年。"
    },
    {
      "event_id": "E005",
      "source_ids": [
        "S005"
      ],
      "type": "speech",
      "speaker_id": "harald",
      "speaker_instance": "harald_greenhouse",
      "voice_id": "harald_f5",
      "source_text": "Blommar den en natt, sen så dör den.",
      "zh_text": "只开一晚，然后它就死了。",
      "start": 10.94,
      "end": 13.55,
      "visible_speech": true,
      "delivery_note": "一晚后稍停，结尾收低。"
    },
    {
      "event_id": "E006",
      "source_ids": [
        "S006"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Hur orkar du vänta så länge?",
      "zh_text": "等那么久，你怎么熬得住？",
      "start": 16.1,
      "end": 18.01,
      "visible_speech": true,
      "delivery_note": "带惊讶问本人怎么等得下去。"
    },
    {
      "event_id": "E007",
      "source_ids": [
        "S007"
      ],
      "type": "speech",
      "speaker_id": "harald",
      "speaker_instance": "harald_greenhouse",
      "voice_id": "harald_f5",
      "source_text": "Det här, det får ta tid.",
      "zh_text": "这事啊，急不得。",
      "start": 20.64,
      "end": 23.08,
      "visible_speech": true,
      "delivery_note": "平静，接纳慢慢等。"
    },
    {
      "event_id": "E008",
      "source_ids": [
        "S008"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Men har du verkligen väntat i tio år?",
      "zh_text": "可你真等了十年吗？",
      "start": 25.78,
      "end": 28.39,
      "visible_speech": true,
      "delivery_note": "转回当事人的实际年数，真字上挑。"
    },
    {
      "event_id": "E009",
      "source_ids": [
        "S009"
      ],
      "type": "speech",
      "speaker_id": "harald",
      "speaker_instance": "harald_greenhouse",
      "voice_id": "harald_f5",
      "source_text": "Tjugofyra nästan. Fast med olika plantor.",
      "zh_text": "都快二十四年了。不过换过几株。",
      "start": 30.27,
      "end": 33.35,
      "visible_speech": true,
      "delivery_note": "先答实数，再补充不是同一株。"
    },
    {
      "event_id": "E010a",
      "source_ids": [
        "S010"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Du verkar …",
      "zh_text": "你好像……",
      "start": 35.12,
      "end": 36.19,
      "visible_speech": false,
      "delivery_note": "迟疑开口，停在半句。"
    },
    {
      "event_id": "E010b",
      "source_ids": [
        "S010"
      ],
      "type": "speech",
      "speaker_id": "harald",
      "speaker_instance": "harald_greenhouse",
      "voice_id": "harald_f5",
      "source_text": "Jag tänkte på plantan.",
      "zh_text": "我是在想那株花。",
      "start": 36.97,
      "end": 38.45,
      "visible_speech": true,
      "delivery_note": "低男声说明他想的是植株，语声比上一句低。"
    },
    {
      "event_id": "E011a",
      "source_ids": [
        "S011"
      ],
      "type": "speech",
      "speaker_id": "harald",
      "speaker_instance": "harald_greenhouse",
      "voice_id": "harald_f5",
      "source_text": "Den väntar hela livet, och sen …",
      "zh_text": "等了一辈子，然后……",
      "start": 38.6,
      "end": 40.7,
      "visible_speech": false,
      "delivery_note": "男声继续说下去，切到听者且尾部保留后面的悬停。"
    },
    {
      "event_id": "E011b",
      "source_ids": [
        "S011"
      ],
      "type": "speech",
      "speaker_id": "harald",
      "speaker_instance": "harald_greenhouse",
      "voice_id": "harald_f5",
      "source_text": "… dör.",
      "zh_text": "……就死了。",
      "start": 41.2,
      "end": 41.96,
      "visible_speech": false,
      "delivery_note": "停顿后还是同一低男声落下，镜头在听者脸上。"
    },
    {
      "event_id": "E012a",
      "source_ids": [
        "S012"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Fan vad sorgligt.",
      "zh_text": "真他妈让人难过。",
      "start": 44.14,
      "end": 45.54,
      "visible_speech": true,
      "delivery_note": "感伤，粗口短促，不发怒。"
    },
    {
      "event_id": "E012b",
      "source_ids": [
        "S012"
      ],
      "type": "speech",
      "speaker_id": "harald",
      "speaker_instance": "harald_greenhouse",
      "voice_id": "harald_f5",
      "source_text": "Tycker inte jag.",
      "zh_text": "我倒不觉得。",
      "start": 45.57,
      "end": 46.53,
      "visible_speech": true,
      "delivery_note": "低声接话，有分寸地反驳。"
    },
    {
      "event_id": "E013a",
      "source_ids": [
        "S013"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Ja!",
      "zh_text": "好耶！",
      "start": 55.9,
      "end": 56.49,
      "visible_speech": true,
      "delivery_note": "进球举手，爆发式欢呼。"
    },
    {
      "event_id": "E013b",
      "source_ids": [
        "S013"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Ja!",
      "zh_text": "好耶！",
      "start": 60.49,
      "end": 61.65,
      "visible_speech": true,
      "delivery_note": "俯身笑着喊，尾音比前次轻。"
    },
    {
      "event_id": "E014a",
      "source_ids": [
        "S014"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Ja!",
      "zh_text": "好耶！",
      "start": 65.04,
      "end": 66.28,
      "visible_speech": true,
      "delivery_note": "边打边喊，咬字快。"
    },
    {
      "event_id": "E014b",
      "source_ids": [
        "S014"
      ],
      "type": "speech",
      "speaker_id": "friend",
      "speaker_instance": "friend_adult",
      "voice_id": "friend_f5",
      "source_text": "Ja, ja, ja!",
      "zh_text": "好，好，好！",
      "start": 67.9,
      "end": 68.92,
      "visible_speech": true,
      "delivery_note": "桌子另一侧急促连喊。"
    },
    {
      "event_id": "E014c",
      "source_ids": [
        "S014"
      ],
      "type": "speech",
      "speaker_id": "friend",
      "speaker_instance": "friend_adult",
      "voice_id": "friend_f5",
      "source_text": "Fan!",
      "zh_text": "该死！",
      "start": 69.35,
      "end": 70.14,
      "visible_speech": false,
      "delivery_note": "隔着冰球台的懊恼短喊。"
    },
    {
      "event_id": "E015a",
      "source_ids": [
        "S015"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Ja, ja!",
      "zh_text": "好！好！",
      "start": 71.55,
      "end": 72.77,
      "visible_speech": true,
      "delivery_note": "扬起手时重复欢呼，第二声更高。"
    },
    {
      "event_id": "E015e",
      "source_ids": [
        "S015"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Jävlar, nej!",
      "zh_text": "哎呀，不行！",
      "start": 73.02,
      "end": 74.0,
      "visible_speech": true,
      "delivery_note": "进球落空后的烦急爆发，接在笑喊后。"
    },
    {
      "event_id": "E015b",
      "source_ids": [
        "S015"
      ],
      "type": "non_speech",
      "speaker_id": "friend",
      "speaker_instance": "friend_adult",
      "voice_id": "friend_f5",
      "source_text": "",
      "zh_text": "",
      "start": 73.9,
      "end": 74.53,
      "visible_speech": true,
      "delivery_note": "桌子另一边笑喘，保留无词的声响。"
    },
    {
      "event_id": "E015d",
      "source_ids": [
        "S015"
      ],
      "type": "speech",
      "speaker_id": "friend",
      "speaker_instance": "friend_adult",
      "voice_id": "friend_f5",
      "source_text": "Öppna!",
      "zh_text": "开啊！",
      "start": 74.63,
      "end": 75.52,
      "visible_speech": true,
      "delivery_note": "金发同伴大声催开，贴着球台动作。"
    },
    {
      "event_id": "E015c",
      "source_ids": [
        "S015"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Yes!",
      "zh_text": "耶！",
      "start": 76.13,
      "end": 77.03,
      "visible_speech": false,
      "delivery_note": "跨到出门镜头前的最后一声，短而亮。"
    },
    {
      "event_id": "E016a",
      "source_ids": [
        "S016"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "God morgon.",
      "zh_text": "早上好。",
      "start": 91.39,
      "end": 92.37,
      "visible_speech": false,
      "delivery_note": "扶着肩膀唤醒床上的梅尔塔。"
    },
    {
      "event_id": "E016b",
      "source_ids": [
        "S016"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "God morgon, Märta.",
      "zh_text": "梅尔塔，早上好。",
      "start": 94.0,
      "end": 95.24,
      "visible_speech": true,
      "delivery_note": "先没有回应，再贴近轻声叫她的名字。"
    },
    {
      "event_id": "E017a",
      "source_ids": [
        "S017"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "God morgon.",
      "zh_text": "早上好。",
      "start": 101.68,
      "end": 103.13,
      "visible_speech": false,
      "delivery_note": "低声重复，等她醒来。"
    },
    {
      "event_id": "E017b",
      "source_ids": [
        "S017"
      ],
      "type": "speech",
      "speaker_id": "marta",
      "speaker_instance": "marta_bedroom",
      "voice_id": "marta_f5",
      "source_text": "Hej.",
      "zh_text": "你好。",
      "start": 103.19,
      "end": 103.63,
      "visible_speech": true,
      "delivery_note": "刚醒，略沙哑的短答。"
    },
    {
      "event_id": "E017c",
      "source_ids": [
        "S017"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "God morgon.",
      "zh_text": "早上好。",
      "start": 104.48,
      "end": 105.44,
      "visible_speech": true,
      "delivery_note": "贴近且带笑地再问候一次。"
    },
    {
      "event_id": "E018a",
      "source_ids": [
        "S018"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Ska vi ta och sitta upp?",
      "zh_text": "来，咱们坐起来？",
      "start": 106.52,
      "end": 108.2,
      "visible_speech": true,
      "delivery_note": "一边商量一边搀扶。"
    },
    {
      "event_id": "E018b",
      "source_ids": [
        "S018"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Så ska vi se.",
      "zh_text": "来，慢慢来。",
      "start": 109.34,
      "end": 110.55,
      "visible_speech": true,
      "delivery_note": "用力时压低的安抚声。"
    },
    {
      "event_id": "E019a",
      "source_ids": [
        "S019"
      ],
      "type": "speech",
      "speaker_id": "marta",
      "speaker_instance": "marta_bedroom",
      "voice_id": "marta_f5",
      "source_text": "Jag drömde om dig innan.",
      "zh_text": "我刚才梦到你了。",
      "start": 116.58,
      "end": 118.53,
      "visible_speech": true,
      "delivery_note": "醒后露出笑，带气息的悄声。"
    },
    {
      "event_id": "E019b",
      "source_ids": [
        "S019"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Gjorde du det?",
      "zh_text": "是吗？",
      "start": 118.99,
      "end": 119.85,
      "visible_speech": true,
      "delivery_note": "笑着往上挑的短问。"
    },
    {
      "event_id": "E020a",
      "source_ids": [
        "S020"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Ska jag känna mig rädd, eller?",
      "zh_text": "那我该害怕吗？",
      "start": 121.39,
      "end": 123.17,
      "visible_speech": true,
      "delivery_note": "笑着逗她，不是真的害怕。"
    },
    {
      "event_id": "E020b",
      "source_ids": [
        "S020"
      ],
      "type": "speech",
      "speaker_id": "marta",
      "speaker_instance": "marta_bedroom",
      "voice_id": "marta_f5",
      "source_text": "Vad är det?",
      "zh_text": "这是什么？",
      "start": 124.31,
      "end": 125.3,
      "visible_speech": true,
      "delivery_note": "注意到手里的东西。"
    },
    {
      "event_id": "E020c",
      "source_ids": [
        "S020"
      ],
      "type": "speech",
      "speaker_id": "marta",
      "speaker_instance": "marta_bedroom",
      "voice_id": "marta_f5",
      "source_text": "Vad flinar du åt?",
      "zh_text": "你笑什么呀？",
      "start": 125.93,
      "end": 127.05,
      "visible_speech": false,
      "delivery_note": "问梅特在笑什么，眼神已转向她。"
    },
    {
      "event_id": "E021",
      "source_ids": [
        "S021"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Titta.",
      "zh_text": "你看。",
      "start": 129.6,
      "end": 130.63,
      "visible_speech": true,
      "delivery_note": "笑着把东西递过去。"
    },
    {
      "event_id": "E022",
      "source_ids": [
        "S022"
      ],
      "type": "speech",
      "speaker_id": "marta",
      "speaker_instance": "marta_bedroom",
      "voice_id": "marta_f5",
      "source_text": "Jag ska inte läsa.",
      "zh_text": "我才不看。",
      "start": 135.71,
      "end": 137.29,
      "visible_speech": true,
      "delivery_note": "把眼光移开，声音冷下来。"
    },
    {
      "event_id": "E023a",
      "source_ids": [
        "S023"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Ska vi duscha?",
      "zh_text": "咱们洗个澡吧？",
      "start": 145.03,
      "end": 146.57,
      "visible_speech": false,
      "delivery_note": "从床边画外柔声提议。"
    },
    {
      "event_id": "E023b",
      "source_ids": [
        "S023"
      ],
      "type": "speech",
      "speaker_id": "marta",
      "speaker_instance": "marta_bedroom",
      "voice_id": "marta_f5",
      "source_text": "Nej!",
      "zh_text": "不要！",
      "start": 147.65,
      "end": 148.15,
      "visible_speech": true,
      "delivery_note": "枕上突然尖声拒绝。"
    },
    {
      "event_id": "E023c",
      "source_ids": [
        "S023"
      ],
      "type": "speech",
      "speaker_id": "marta",
      "speaker_instance": "marta_bedroom",
      "voice_id": "marta_f5",
      "source_text": "Inte igen!",
      "zh_text": "又来！",
      "start": 149.01,
      "end": 150.26,
      "visible_speech": true,
      "delivery_note": "拒绝之后烦躁地再顶一句。"
    },
    {
      "event_id": "E024",
      "source_ids": [
        "S024"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Jag tycker att din son är en stor idiot",
      "zh_text": "我看你儿子真是个混蛋，",
      "start": 247.87,
      "end": 252.46,
      "visible_speech": false,
      "delivery_note": "替老人鸣不平，先落到对儿子的评价。"
    },
    {
      "event_id": "E025",
      "source_ids": [
        "S025"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "som inte kommer hit och hälsar på.",
      "zh_text": "都不来这儿看看你。",
      "start": 252.47,
      "end": 254.7,
      "visible_speech": true,
      "delivery_note": "说清到访没有发生，接上刚才的判断。"
    },
    {
      "event_id": "E026",
      "source_ids": [
        "S026"
      ],
      "type": "speech",
      "speaker_id": "mette",
      "speaker_instance": "mette_adult",
      "voice_id": "mette_f5",
      "source_text": "Men om du vill, så kan jag se till att han kommer hit.",
