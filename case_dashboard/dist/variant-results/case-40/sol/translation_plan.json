{
  "events": [
    {
      "event_id": "S001",
      "source_ids": [
        "S001"
      ],
      "type": "speech",
      "speaker_id": "victor",
      "speaker_instance": "victor_adult",
      "voice_id": "f5_victor",
      "source_text": "My name is Victor.",
      "zh_text": "我叫维克托。",
      "start": 1.33,
      "end": 2.2,
      "visible_speech": true,
      "delivery_note": "站着自我介绍。音量克制，名字说清，接着等回应。"
    },
    {
      "event_id": "S002",
      "source_ids": [
        "S002"
      ],
      "type": "speech",
      "speaker_id": "victor",
      "speaker_instance": "victor_adult",
      "voice_id": "f5_victor",
      "source_text": "Hi.",
      "zh_text": "嗨。",
      "start": 4.44,
      "end": 4.88,
      "visible_speech": true,
      "delivery_note": "隔了一拍才补上一声轻轻的招呼，尾音落下。"
    },
    {
      "event_id": "S003",
      "source_ids": [
        "S003"
      ],
      "type": "speech",
      "speaker_id": "victor",
      "speaker_instance": "victor_adult",
      "voice_id": "f5_victor",
      "source_text": "And you are... You're Franck.",
      "zh_text": "你是……你是弗兰克。",
      "start": 6.94,
      "end": 10.62,
      "visible_speech": true,
      "delivery_note": "先在弗兰克的反打镜头外试探地问。等不到回答，镜头切回后自己认出他并叫出名字。"
    },
    {
      "event_id": "S004",
      "source_ids": [
        "S004"
      ],
      "type": "speech",
      "speaker_id": "victor",
      "speaker_instance": "victor_adult",
      "voice_id": "f5_victor",
      "source_text": "Oh, you're so much more than just a sheep, aren't you?",
      "zh_text": "哦，你可远不止是一只羊，对吧？",
      "start": 12.44,
      "end": 15.73,
      "visible_speech": true,
      "delivery_note": "先在反打镜头外开口，重读夸赞的程度，顿一拍再抛出带引导意味的反问。"
    },
    {
      "event_id": "S005",
      "source_ids": [
        "S005"
      ],
      "type": "speech",
      "speaker_id": "franck",
      "speaker_instance": "franck_adult_sheep",
      "voice_id": "f5_franck",
      "source_text": "Yeah?",
      "zh_text": "嗯？",
      "start": 16.7,
      "end": 17.3,
      "visible_speech": false,
      "delivery_note": "弗兰克在前景背面有一声猛然上扬的应声，介于开口回应和羊叫语气之间。维克托双手搭着，嘴基本合拢。"
    },
    {
      "event_id": "S006",
      "source_ids": [
        "S006"
      ],
      "type": "speech",
      "speaker_id": "franck",
      "speaker_instance": "franck_adult_sheep",
      "voice_id": "f5_franck",
      "source_text": "How would you know?",
      "zh_text": "你怎么会知道？",
      "start": 18.69,
      "end": 20.25,
      "visible_speech": true,
      "delivery_note": "切到弗兰克。他不领情，带着疑心反问，重心在“知道”。"
    },
    {
      "event_id": "S007",
      "source_ids": [
        "S007"
      ],
      "type": "speech",
      "speaker_id": "victor",
      "speaker_instance": "victor_adult",
      "voice_id": "f5_victor",
      "source_text": "Look at you. You're an adventurer, Franck.",
      "zh_text": "你看，你可是个冒险家，弗兰克。",
      "start": 22.33,
      "end": 24.7,
      "visible_speech": true,
      "delivery_note": "维克托打量对方，摊手顺势恭维，落到对方的名字上。"
    },
    {
      "event_id": "S008",
      "source_ids": [
        "S008"
      ],
      "type": "speech",
      "speaker_id": "victor",
      "speaker_instance": "victor_adult",
      "voice_id": "f5_victor",
      "source_text": "Just like me. You're a lone wolf.",
      "zh_text": "跟我一样。你是个独狼。",
      "start": 25.9,
      "end": 28.73,
      "visible_speech": true,
      "delivery_note": "弗兰克反打时维克托先拿自己作比。中间停一拍，切回维克托后才给对方贴“独狼”的比喻。"
    },
    {
      "event_id": "S009",
      "source_ids": [
        "S009"
      ],
      "type": "speech",
      "speaker_id": "victor",
      "speaker_instance": "victor_adult",
      "voice_id": "f5_victor",
      "source_text": "Tell me, does one choose to be alone?",
      "zh_text": "你说，人会自己选择孤身一人吗？",
      "start": 30.57,
      "end": 33.8,
      "visible_speech": true,
      "delivery_note": "维克托连着发问。中段先抬高“选择”，空一拍才把独处的设问说完。后半句越过镜头切换。"
    },
    {
      "event_id": "S010",
      "source_ids": [
        "S010"
      ],
      "type": "speech",
      "speaker_id": "victor",
      "speaker_instance": "victor_adult",
      "voice_id": "f5_victor",
      "source_text": "No, one doesn't.",
      "zh_text": "不，人不会。",
      "start": 34.92,
      "end": 36.13,
      "visible_speech": true,
      "delivery_note": "维克托接自己的问话，先落一个“不”，稍顿再确认。否定的是自己选择独处。"
    },
    {
      "event_id": "S011",
      "source_ids": [
        "S011"
      ],
      "type": "speech",
      "speaker_id": "victor",
      "speaker_instance": "victor_adult",
      "voice_id": "f5_victor",
      "source_text": "One doesn't even choose to be a wolf.",
      "zh_text": "连当狼都不是自己选的。",
      "start": 37.12,
      "end": 39.03,
      "visible_speech": true,
      "delivery_note": "同一人把否定推进一层，转到连是否成为狼都无从选择，重音落在“连”和“选”上。"
    },
    {
      "event_id": "S012",
      "source_ids": [
        "S012"
      ],
      "type": "speech",
      "speaker_id": "victor",
      "speaker_instance": "victor_adult",
      "voice_id": "f5_victor",
      "source_text": "Or does one?",
      "zh_text": "还是能选？",
      "start": 41.91,
      "end": 42.65,
      "visible_speech": true,
      "delivery_note": "停过一个完整节拍之后，维克托又试探性地把刚才的结论翻成疑问。"
    },
    {
      "event_id": "S013",
      "source_ids": [
        "S013"
      ],
      "type": "speech",
      "speaker_id": "franck",
      "speaker_instance": "franck_adult_sheep",
      "voice_id": "f5_franck",
      "source_text": "Well, Mr. Hector...",
      "zh_text": "呃……赫克托先生……",
      "start": 47.36,
      "end": 50.69,
      "visible_speech": true,
      "delivery_note": "弗兰克拖了一拍才开口，半吞半吐地误叫赫克托。尾巴被对方接过去。"
    },
    {
      "event_id": "S014",
      "source_ids": [
        "S014"
      ],
      "type": "speech",
      "speaker_id": "victor",
      "speaker_instance": "victor_adult",
      "voice_id": "f5_victor",
      "source_text": "Victor. Victor.",
      "zh_text": "维克托，维克托。",
      "start": 50.58,
      "end": 51.7,
      "visible_speech": true,
      "delivery_note": "维克托抢拍截住误称。同一个真名说两次，第一次纠正，第二次更短更明确。"
    },
    {
      "event_id": "S015",
      "source_ids": [
        "S015"
      ],
      "type": "speech",
      "speaker_id": "franck",
      "speaker_instance": "franck_adult_sheep",
      "voice_id": "f5_franck",
      "source_text": "I don't know what you're on about,",
      "zh_text": "我不知道你在说什么，",
      "start": 51.91,
      "end": 53.44,
      "visible_speech": true,
      "delivery_note": "弗兰克接回话头，带着不耐烦，否定的是听懂维克托在讲什么。"
    },
    {
      "event_id": "S016",
      "source_ids": [
        "S016"
      ],
      "type": "speech",
      "speaker_id": "franck",
      "speaker_instance": "franck_adult_sheep",
      "voice_id": "f5_franck",
      "source_text": "but I'm just a sheep minding its own business.",
      "zh_text": "可我就是一只羊，只管自己的事。",
      "start": 53.45,
      "end": 57.24,
      "visible_speech": true,
      "delivery_note": "转折后先划清自己的身份，再强调只管自己的事，尾部放缓。"
    },
    {
      "event_id": "S017",
      "source_ids": [
        "S017"
      ],
      "type": "speech",
      "speaker_id": "franck",
      "speaker_instance": "franck_adult_sheep",
      "voice_id": "f5_franck",
      "source_text": "And I suggest you do the same.",
      "zh_text": "我劝你也只管自己的事。",
      "start": 58.54,
      "end": 60.71,
      "visible_speech": true,
      "delivery_note": "弗兰克把刚说的处事原则反向丢给维克托。语气是冷冷的劝止，镜头先在对方脸上。"
    },
    {
      "event_id": "S018",
      "source_ids": [
        "S018"
      ],
      "type": "speech",
      "speaker_id": "victor",
      "speaker_instance": "victor_adult",
      "voice_id": "f5_victor",
      "source_text": "No, no, no, no! Franck! Wait, wait, wait!",
      "zh_text": "不、不、不、不！弗兰克！等、等、等等！",
      "start": 61.3,
      "end": 63.38,
      "visible_speech": true,
      "delivery_note": "维克托先冒出一个“不”，举手时三个“不”挤在一起。喊名字后连续三次叫他等，后半切到维克托的嘴。"
    },
    {
      "event_id": "S019",
      "source_ids": [
        "S019"
      ],
      "type": "speech",
      "speaker_id": "victor",
      "speaker_instance": "victor_adult",
      "voice_id": "f5_victor",
      "source_text": "No. This is not...",
      "zh_text": "不……不能……",
      "start": 63.91,
      "end": 65.21,
      "visible_speech": true,
      "delivery_note": "手势过后，维克托低一层重启，说了“不”又停住，否定句悬在半空中。"
    },
    {
      "event_id": "S020",
      "source_ids": [
        "S020"
      ],
      "type": "speech",
      "speaker_id": "victor",
      "speaker_instance": "victor_adult",
      "voice_id": "f5_victor",
      "source_text": "...the way.",
      "zh_text": "……这么做。",
      "start": 65.88,
      "end": 66.37,
      "visible_speech": false,
      "delivery_note": "镜头已经切开，这一小截从画外把上一句接完。尾音收住，留出下一次请求的起拍。"
    },
    {
      "event_id": "S021",
      "source_ids": [
        "S021"
      ],
      "type": "speech",
      "speaker_id": "victor",
      "speaker_instance": "victor_adult",
      "voice_id": "f5_victor",
      "source_text": "Just give me one minute of your precious time.",
      "zh_text": "就耽误你一分钟宝贵的时间。",
      "start": 66.52,
      "end": 69.33,
      "visible_speech": false,
      "delivery_note": "坐下的维克托放软声音提出请求，一分钟四字的数字部分要清澈，后半“宝贵的时间”略带讨好。"
    },
    {
      "event_id": "S022",
      "source_ids": [
        "S022"
      ],
      "type": "speech",
      "speaker_id": "franck",
      "speaker_instance": "franck_adult_sheep",
      "voice_id": "f5_franck",
      "source_text": "Precious time.",
      "zh_text": "宝贵的时间？",
      "start": 70.48,
      "end": 72.25,
      "visible_speech": true,
      "delivery_note": "弗兰克抬起嘴角，把对方的话冷冷重复出来。中间咬出空拍，带反讽和质疑。"
    },
    {
      "event_id": "S022-2",
      "source_ids": [
        "S022"
      ],
      "type": "non_speech",
      "speaker_id": "franck",
      "speaker_instance": "franck_adult_sheep",
      "voice_id": "f5_franck",
      "source_text": "",
      "zh_text": "",
      "start": 72.39,
      "end": 73.22,
      "visible_speech": true,
      "delivery_note": "反讽后弗兰克嘴角露齿，有三下短促的干笑。保留独立的原声反应，末尾很轻。"
    },
    {
      "event_id": "S023",
      "source_ids": [
        "S023"
      ],
      "type": "speech",
      "speaker_id": "victor",
      "speaker_instance": "victor_adult",
      "voice_id": "f5_victor",
      "source_text": "Yeah, just give me one minute.",
      "zh_text": "对，就给我一分钟。",
      "start": 74.03,
      "end": 75.57,
      "visible_speech": false,
      "delivery_note": "维克托稳住声量，先承接对方的反讽，再直截了当重提同样的一分钟。"
    },
    {
      "event_id": "S024",
      "source_ids": [
        "S024"
      ],
      "type": "speech",
      "speaker_id": "victor",
      "speaker_instance": "victor_adult",
      "voice_id": "f5_victor",
      "source_text": "You would have one more minute, wouldn't you?",
      "zh_text": "你总还有一分钟吧？",
      "start": 76.15,
      "end": 78.13,
      "visible_speech": false,
      "delivery_note": "维克托继续追问还能不能给一分钟。弗兰克在前景收拢嘴、垂眼听，句尾仍来自画外的维克托。"
    }
  ]
}
