  "srt_entries": [
    {
      "start": 4.603,
      "end": 8.486,
      "text": "这只棕褐色的小鸟，我暂定为巨嘴短翅莺。"
    },
    {
      "start": 11.903,
      "end": 16.065,
      "text": "注意它较长、略向下弯的嘴，还有细长的尾羽。"
    },
    {
      "start": 27.303,
      "end": 31.266,
      "text": "喉部偏浅，翅膀短，身上的花纹很不显眼。"
    },
    {
      "start": 34.403,
      "end": 39.563,
      "text": "短促的鸣声反复出现；静态近照无法核对发声个体。"
    },
    {
      "start": 50.303,
      "end": 53.136,
      "text": "这段也暂按巨嘴短翅莺来判断。"
    },
    {
      "start": 55.903,
      "end": 59.866,
      "text": "短促的鸣声重复出现，鸟却藏在密叶后面。"
    },
    {
      "start": 65.103,
      "end": 69.013,
      "text": "看不清嘴部，声音与个体的对应仍有不确定。"
    },
    {
      "start": 76.103,
      "end": 79.813,
      "text": "我把它暂定为柳纹霸鹟，浅眼圈并不醒目。"
    },
    {
      "start": 83.103,
      "end": 87.611,
      "text": "它停在裸枝上，时而张嘴，短促的鸣唱分句出现。"
    },
    {
      "start": 92.603,
      "end": 97.377,
      "text": "这类小鸟常从枝头出击捕虫，片中主要是在停栖。"
    },
    {
      "start": 104.203,
      "end": 108.113,
      "text": "芦苇间这只小鸟，暂定为长嘴沼泽鹪鹩。"
    },
    {
      "start": 111.103,
      "end": 114.614,
      "text": "浅色眉纹和较深的头顶，时隐时现。"
    },
    {
      "start": 118.103,
      "end": 122.039,
      "text": "急促的鸣唱不断换句，但嘴部始终看不清。"
    },
    {
      "start": 128.103,
      "end": 133.505,
      "text": "这是黑脚信天翁。蓬松的褐色绒羽，说明它还是雏鸟。"
    },
    {
      "start": 139.103,
      "end": 144.316,
      "text": "成鸟靠近后，雏鸟把嘴伸向成鸟的嘴边，接受喂食。"
    },
    {
      "start": 151.603,
      "end": 155.579,
      "text": "短促的叫声夹在背景里，未必都来自这一对。"
    },
    {
      "start": 162.103,
      "end": 167.063,
      "text": "这是黑背信天翁，白色头颈与深色背翼对比鲜明。"
    },
    {
      "start": 174.603,
      "end": 179.297,
      "text": "它们面对面点头、仰头、碰嘴，展示求偶的舞步。"
    },
    {
      "start": 182.103,
      "end": 183.978,
      "text": "短叫和敲嘴声交织。"
    }
  ]
}