      "index": 8,
      "segment": 3,
      "text": "它停在裸枝上，时而张嘴，短促的鸣唱分句出现。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795080240.7731981,
