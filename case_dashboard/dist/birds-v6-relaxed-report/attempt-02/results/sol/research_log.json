    },
    {
      "stage": "TTS调用重试",
      "index": 0,
      "attempt": 0,
      "error": "NoAudioReceived('No audio was received. Please verify that your parameters are correct.')",
      "unix": 1795079704.380626
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 0,
      "segment": 1,
      "text": "这只棕褐色的小鸟，我暂定为巨嘴短翅莺。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079699.3609905,
      "end_unix": 1795079708.1114492,
      "elapsed_seconds": 8.75045919418335,
      "duration_seconds": 4.584,
      "mp3_sha256": "7722c16cd9d249256a1657cf6793ab615c71a2df9b876bd1e61d689c315e03cf"
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 1,
      "segment": 1,
      "text": "注意它较长、略向下弯的嘴，还有细长的尾羽。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079708.1423502,
      "end_unix": 1795079710.376698,
      "elapsed_seconds": 2.2343480587005615,
      "duration_seconds": 4.896,
      "mp3_sha256": "110823abe6648a906ae4550ae41c3fe916a14ef0b71eebdfbd54a907386a7660"
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 2,
      "segment": 1,
      "text": "喉部偏浅，翅膀短，身上的花纹很不显眼。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079710.3850605,
      "end_unix": 1795079712.6654327,
      "elapsed_seconds": 2.280372142791748,
      "duration_seconds": 4.68,
      "mp3_sha256": "bfbd98ce03381883a2ba6138d04a661cd5267b421f6eb2e60902d65c50f2e2da"
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 3,
      "segment": 1,
      "text": "这里是静态近照，不能把录音里的每一声都归给它。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079712.6815765,
      "end_unix": 1795079715.2898417,
      "elapsed_seconds": 2.6082653999328613,
      "duration_seconds": 5.232,
      "mp3_sha256": "8476064f82e3f4bcf0190c2f01b7fb4e653a5990ec8b1ee87a2b771cfabb0f2c"
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 4,
      "segment": 2,
      "text": "这段也暂按巨嘴短翅莺来判断。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079715.3189254,
      "end_unix": 1795079717.7698388,
      "elapsed_seconds": 2.450913429260254,
      "duration_seconds": 3.552,
      "mp3_sha256": "9bdc580136f40088b60596bb8c7b7ffef63fea4ff3d35810ef8ee0e4fc292f78"
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 5,
      "segment": 2,
      "text": "短促的鸣声重复出现，鸟却藏在密叶后面。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079717.782843,
      "end_unix": 1795079720.4299264,
      "elapsed_seconds": 2.6470835208892822,
      "duration_seconds": 4.68,
      "mp3_sha256": "ff9e996da50e87ff9719c76771586ea1661aa8a1f971e414434d4172fc531bb6"
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 6,
      "segment": 2,
      "text": "看不清嘴部，声音与个体的对应仍有不确定。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079720.4432805,
      "end_unix": 1795079723.010684,
      "elapsed_seconds": 2.567403793334961,
      "duration_seconds": 4.632,
      "mp3_sha256": "2a6ef55e27f3caecf9379e1fbc7870fc19c477a5a978558c75e0f2e5f5c27cd9"
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 7,
      "segment": 3,
      "text": "我把它暂定为柳纹霸鹟，浅眼圈并不醒目。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079723.0233233,
      "end_unix": 1795079726.023226,
      "elapsed_seconds": 2.9999029636383057,
      "duration_seconds": 4.416,
      "mp3_sha256": "708282fef24158b2200300d8bba55c741cf52f9070b1593e721db66db828a34e"
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 8,
      "segment": 3,
      "text": "它停在裸枝上，转头张望，嘴巴也不时张开。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079726.0905097,
      "end_unix": 1795079728.6982002,
      "elapsed_seconds": 2.6076908111572266,
      "duration_seconds": 4.92,
      "mp3_sha256": "c517b7cf23f0f98869f6c62658300110008752051e2057b739e0b0336bcdd1ee"
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 9,
      "segment": 3,
      "text": "这类小鸟常从枝头出击捕虫，片中主要是在停栖。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079728.712174,
      "end_unix": 1795079731.4722502,
      "elapsed_seconds": 2.7600762844085693,
      "duration_seconds": 5.472,
      "mp3_sha256": "c93f660fabb23d2532a050756f4baa7b0633d287d88b41a02ca166bc8fc606ac"
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 10,
      "segment": 4,
      "text": "芦苇间这只小鸟，暂定为长嘴沼泽鹪鹩。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079731.5092854,
      "end_unix": 1795079734.3329442,
      "elapsed_seconds": 2.8236589431762695,
      "duration_seconds": 4.632,
      "mp3_sha256": "dd9f2ba052efa017b6b0da22b673eba600836eda89e62a012fd7c0958ebad6c1"
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 11,
      "segment": 4,
      "text": "浅色眉纹和较深的头顶，时隐时现。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079734.3444405,
      "end_unix": 1795079739.07974,
      "elapsed_seconds": 4.735300064086914,
      "duration_seconds": 4.224,
      "mp3_sha256": "53cbe3df39f5b99fec9789d4b09a53272c729ebff99dd225961d7de4a69f2624"
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 12,
      "segment": 4,
      "text": "急促的鸣唱不断换句，但嘴部始终看不清。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079739.089488,
      "end_unix": 1795079742.2141745,
      "elapsed_seconds": 3.1246867179870605,
      "duration_seconds": 4.656,
      "mp3_sha256": "db396c3f8e68f979247268a72f990e87d1aa0bd96eb177206eb3f08556224d72"
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 13,
      "segment": 5,
      "text": "这是黑脚信天翁。蓬松的褐色绒羽，说明它还是雏鸟。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079742.26671,
      "end_unix": 1795079745.2540917,
      "elapsed_seconds": 2.987381935119629,
      "duration_seconds": 6.12,
      "mp3_sha256": "a6cc8b557958760f366ac7d63c6588d8ae2590740273bc08132ff3f9a68776df"
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 14,
      "segment": 5,
      "text": "成鸟靠近后，雏鸟把嘴伸向成鸟的嘴边，接受喂食。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079745.2828941,
      "end_unix": 1795079748.288798,
      "elapsed_seconds": 3.00590443611145,
      "duration_seconds": 5.928,
      "mp3_sha256": "a946d197de24a08260ce0b97bd0f4a8c10fa5fd8a4e0868903cfe62ffd4b3cd1"
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 15,
      "segment": 5,
      "text": "群落里还有别的鸟，鸣声未必都来自这一对。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079748.3202202,
      "end_unix": 1795079752.4226465,
      "elapsed_seconds": 4.102426767349243,
      "duration_seconds": 4.512,
      "mp3_sha256": "afee4b849f32cb9980cafb4da6f5a2d0e38214284969f037ffc9ed270fcf2012"
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 16,
      "segment": 6,
      "text": "这是白背信天翁，白色头颈与深色背翼对比鲜明。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079752.4344978,
      "end_unix": 1795079755.4749606,
      "elapsed_seconds": 3.0404629707336426,
      "duration_seconds": 5.592,
      "mp3_sha256": "b4153852981e2c1b3cdb90028dc96bf7544d4988b84e89e17785c7bbae81946d"
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 17,
      "segment": 6,
      "text": "它们面对面点头、仰头、碰嘴，展示求偶的舞步。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079755.4901392,
      "end_unix": 1795079758.1850808,
      "elapsed_seconds": 2.694941997528076,
      "duration_seconds": 5.4,
      "mp3_sha256": "5ca3b69ca704a43202cd7ece1a9f779d652aa4afbbf08edf55d83ba44523e2e9"
    },
    {
      "stage": "旁白逐句实际合成",
      "index": 18,
      "segment": 6,
      "text": "短叫和敲嘴声交织。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "start_unix": 1795079758.198247,
      "end_unix": 1795079760.9874,
      "elapsed_seconds": 2.7891533374786377,
      "duration_seconds": 2.592,
      "mp3_sha256": "2fcb8b56872c3b90d0f58f33f63d00f2316071aca4e48bfb26df34163699bdab"
    },
