  "srt_entries": [
    {
      "start": 5.3,
      "end": 7.226,
      "text": "这是宽尾树莺。"
    },
    {
      "start": 7.226,
      "end": 11.687,
      "text": "背部棕褐，喉部偏白，翅短，尾巴宽圆。"
    },
    {
      "start": 25.1,
      "end": 27.684,
      "text": "它常藏在浓密的植被里。"
    },
    {
      "start": 27.684,
      "end": 31.921,
      "text": "这里的近景中，并没有看见它张嘴鸣叫。"
    },
    {
      "start": 35.9,
      "end": 40.51,
      "text": "原声中，重复的短音与成串的高音交替出现，"
    },
    {
      "start": 40.51,
      "end": 44.021,
      "text": "但不能认定都来自画面中的个体。"
    },
    {
      "start": 50.3,
      "end": 54.934,
      "text": "灌丛里这串突出的鸣唱，也暂定为宽尾树莺。"
    },
    {
      "start": 61.6,
      "end": 65.395,
      "text": "几个短音接着密集重复，随后停顿。"
    },
    {
      "start": 65.395,
      "end": 69.658,
      "text": "鸟藏在枝叶后，画面没有给出清楚的外形。"
    },
    {
      "start": 78.2,
      "end": 81.376,
      "text": "枝头这只，暂定为柳纹霸鹟。"
    },
    {
      "start": 81.376,
      "end": 86.1,
      "text": "留意浅色喉部、淡淡的翼斑，还有细细的眼圈。"
    },
    {
      "start": 92.1,
      "end": 94.553,
      "text": "它不时转头、张嘴。"
    },
    {
      "start": 94.553,
      "end": 99.868,
      "text": "短促的两段式鸣唱，比相似的外形更有辨识价值。"
    },
    {
      "start": 105.1,
      "end": 107.434,
      "text": "这里暂定为芦苇莺。"
    },
    {
      "start": 107.434,
      "end": 112.632,
      "text": "它常在苇丛中活动，但这次，鸟体被叶片挡住了。"
    },
    {
      "start": 115.7,
      "end": 119.637,
      "text": "连续变化的鸣唱，是主要的辨认线索。"
    },
    {
      "start": 128.4,
      "end": 133.182,
      "text": "黑脚信天翁的雏鸟，披着褐色绒羽，张着嘴。"
    },
    {
      "start": 133.182,
      "end": 136.313,
      "text": "原声中有接连的尖细叫声。"
    },
    {
      "start": 139.1,
      "end": 142.908,
      "text": "成鸟也是暗褐色，嘴基周围略浅。"
    },
    {
      "start": 142.908,
      "end": 146.145,
      "text": "现在，它正低头靠近雏鸟。"
    },
    {
      "start": 151.1,
      "end": 155.55,
      "text": "嘴部接触符合喂雏行为，但看不清食物。"
    },
    {
      "start": 164.3,
      "end": 170.158,
      "text": "这是黑背信天翁，白色的头颈与深色背翅，对比鲜明。"
    },
    {
      "start": 174.4,
      "end": 179.131,
      "text": "伸颈、仰头、相互点嘴，伴着叫声和喙击声，"
    },
    {
      "start": 179.131,
      "end": 181.613,
      "text": "这是它们的求偶展示。"
    }
  ]
}