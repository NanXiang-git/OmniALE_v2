  "transcription": {
    "mix": [
      {
        "start": 0.11,
        "end": 4.83,
        "text": "半前,会近天,看见豆腐和炒树菜的三个操作细节",
        "avg_logprob": -0.194
      },
      {
        "start": 5.27,
        "end": 9.55,
        "text": "先看第一锅,空过刚方上炉面手就拧开了炉扭",
        "avg_logprob": -0.194
      },
      {
        "start": 11.63,
        "end": 15.07,
        "text": "往后看换到左边的炉威过力,还是空的",
        "avg_logprob": -0.194
      },
      {
        "start": 18.32,
        "end": 22.54,
        "text": "开火一分多钟,后才凉出橄榄油倒进这口锅里",
        "avg_logprob": -0.194
      },
      {
        "start": 26.61,
        "end": 30.47,
        "text": "下次限量一汤匙橄榄油倒进不站过再开中火",
        "avg_logprob": -0.194
      },
      {
        "start": 31.85,
        "end": 37.37,
        "text": "跳到第一次泛面,豆腐已经用夹子泛动过还在左前炉券上",
        "avg_logprob": -0.194
      },
      {
        "start": 40.58,
        "end": 45.92,
        "text": "再看这轮饭面的末尾,夹子换到左手右手,这才提过离火。",
        "avg_logprob": -0.157
      },
      {
        "start": 50.23,
        "end": 56.69,
        "text": "中火煎约5-6分钟,底面为黄石线,短暂离火等油渐减轻再用夹子饭面。",
        "avg_logprob": -0.157
      },
      {
        "start": 57.95,
        "end": 60.97,
        "text": "换看另一锅豆腐限量油道,进锅里。",
        "avg_logprob": -0.157
      },
      {
        "start": 63.04,
        "end": 64.78,
        "text": "挑锅下豆腐和加盐。",
        "avg_logprob": -0.157
      },
      {
        "start": 65.12,
        "end": 67.54,
        "text": "现在开中火从这里酸受热时间。",
        "avg_logprob": -0.157
      },
      {
        "start": 70.42,
        "end": 75.7,
        "text": "挑锅约5分半钟,夹子清台一块茶,看底面放回后,继续煎。",
        "avg_logprob": -0.157
      },
      {
        "start": 79.98,
        "end": 83.96,
        "text": "又过了月三分钟先,把锅移到左侧离开加热去。",
        "avg_logprob": -0.185
      },
      {
        "start": 88.8,
        "end": 92.06,
        "text": "这时才煮块正式饭面露出的底面味黄。",
        "avg_logprob": -0.185
      },
      {
        "start": 93.76,
        "end": 96.2,
        "text": "这段尾键证据充分的偏差。",
        "avg_logprob": -0.185
      },
      {
        "start": 98.4,
        "end": 103.86,
        "text": "再看西兰花炒蔬菜,砧板上切好的蒜末挂,进了拦碗。",
        "avg_logprob": -0.185
      },
      {
        "start": 107.62,
        "end": 111.02,
        "text": "再往后亮勺把黑胡椒送进同一碗,浇制。",
        "avg_logprob": -0.185
      },
      {
        "start": 115.04,
        "end": 118.4,
        "text": "跳到第一次搅拌,浇制搅匀就放在一旁。",
        "avg_logprob": -0.185
      },
      {
        "start": 120.94,
        "end": 123.94,
        "text": "回看配料過,成為煎蛋獨家入薑末",
        "avg_logprob": -0.239
      },
      {
        "start": 126.28,
        "end": 128.82,
        "text": "跳刀炒菜的末段醬製到勁了過",
        "avg_logprob": -0.239
      },
      {
        "start": 128.82,
        "end": 131.78,
        "text": "金頭外有沒有加薑無法確認",
        "avg_logprob": -0.239
      },
      {
        "start": 131.78,
        "end": 139.14,
        "text": "蝦子餡量般湯匙薑末和蒜末分別合對",
        "avg_logprob": -0.239
      },
      {
        "start": 139.14,
        "end": 142.52,
        "text": "確認薑末已入碗在把薑汁攪勻備用",
        "avg_logprob": -0.239
      },
      {
        "start": 144.82,
        "end": 148.22,
        "text": "上造餡加油飯面餡離火調薑餡茶薑末",
        "avg_logprob": -0.239
      }
    ],
