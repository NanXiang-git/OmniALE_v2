{
  "notes": "Per-cue static AD gain only; no time stretching; PCM24 stereo assets are the offline reconstruction masters.",
  "cues": [
    {
      "id": "AD01",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.018895833333333334,
      "duration": 4.414354166666667,
      "gain_db": -3.60291029379425,
      "peak_dbfs": -5.069842554359481,
      "target_active_rms_dbfs": -26.0,
      "text": "红发女子提着长柄弯刃，走进幽暗的洞穴。"
    },
    {
      "id": "AD02",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.057166666666666664,
      "duration": 2.683895833333333,
      "gain_db": -3.1182888405699227,
      "peak_dbfs": -6.343965839135912,
      "target_active_rms_dbfs": -26.0,
      "text": "岩柱间，水晶泛着蓝光。"
    },
    {
      "id": "AD03",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.034395833333333334,
      "duration": 3.1552291666666665,
      "gain_db": -4.86510133547747,
      "peak_dbfs": -9.170889295644782,
      "target_active_rms_dbfs": -26.0,
      "text": "一条大龙，正在撕咬带血的肉。"
    },
    {
      "id": "AD04",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.022041666666666668,
      "duration": 2.4465833333333333,
      "gain_db": -5.702091894769087,
      "peak_dbfs": -7.845952001789103,
      "target_active_rms_dbfs": -26.0,
      "text": "女子望向它身后的高台。"
    },
    {
      "id": "AD05",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.0226875,
      "duration": 3.048791666666667,
      "gain_db": -5.159118617110151,
      "peak_dbfs": -5.554178552566235,
      "target_active_rms_dbfs": -26.0,
      "text": "她跃下岩台，蹲着向前挪。"
    },
    {
      "id": "AD06",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.015916666666666666,
      "duration": 2.6146458333333333,
      "gain_db": -5.114648742898071,
      "peak_dbfs": -5.971443490171538,
      "target_active_rms_dbfs": -26.0,
      "text": "巢里，还蜷着一只幼龙。"
    },
    {
      "id": "AD07",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.0226875,
      "duration": 2.577354166666667,
      "gain_db": -6.762988365182253,
      "peak_dbfs": -7.181381799259142,
      "target_active_rms_dbfs": -26.0,
      "text": "她避开龙火，躲到柱后。"
    },
    {
      "id": "AD08",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.042166666666666665,
      "duration": 1.1601875,
      "gain_db": -1.6352812112364354,
      "peak_dbfs": -8.330295884510099,
      "target_active_rms_dbfs": -24.5,
      "text": "幼龙飞开了。"
    },
    {
      "id": "AD09",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.0226875,
      "duration": 3.2054375,
      "gain_db": -2.856806788640209,
      "peak_dbfs": -3.9999999999999996,
      "target_active_rms_dbfs": -22.5,
      "text": "她跃上龙颈，横杆卡住龙嘴。"
    },
    {
      "id": "AD10",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.015916666666666666,
      "duration": 2.7522083333333334,
      "gain_db": -5.457958415925922,
      "peak_dbfs": -5.989458989419782,
      "target_active_rms_dbfs": -26.0,
      "text": "长柄折断，她被甩落在地。"
    },
    {
      "id": "AD11",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.0253125,
      "duration": 1.8385208333333334,
      "gain_db": -4.734039940484953,
      "peak_dbfs": -8.323055087516696,
      "target_active_rms_dbfs": -26.0,
      "text": "龙尾又将她扫倒。"
    },
    {
      "id": "AD12",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.0458125,
      "duration": 1.5825625,
      "gain_db": -3.82579168819482,
      "peak_dbfs": -4.515115881478588,
      "target_active_rms_dbfs": -24.5,
      "text": "大龙腾空而起。"
    },
    {
      "id": "AD13",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.0458125,
      "duration": 1.2560208333333334,
      "gain_db": -5.7804742836126435,
      "peak_dbfs": -6.455748507925017,
      "target_active_rms_dbfs": -26.0,
      "text": "大龙停住了。"
    },
    {
      "id": "AD14",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.0226875,
      "duration": 1.7519166666666666,
      "gain_db": -4.383593952512545,
      "peak_dbfs": -6.447750947508624,
      "target_active_rms_dbfs": -26.0,
      "text": "它轻轻拱她的背。"
    },
    {
      "id": "AD15",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.0226875,
      "duration": 3.852104166666667,
      "gain_db": -3.919758902665427,
      "peak_dbfs": -4.505250535067161,
      "target_active_rms_dbfs": -26.0,
      "text": "她拾起折断的武器，刺进了大龙胸口。"
    },
    {
      "id": "AD16",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.040875,
      "duration": 3.6538541666666666,
      "gain_db": -5.776056769140844,
      "peak_dbfs": -6.458783248747669,
      "target_active_rms_dbfs": -26.0,
      "text": "大龙展开的翅膜上，留着一道旧疤。"
    },
    {
      "id": "AD17",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.03575,
      "duration": 3.5028958333333335,
      "gain_db": -4.326688926894202,
      "peak_dbfs": -6.973749027106676,
      "target_active_rms_dbfs": -26.0,
      "text": "这大龙，竟是她当年救下的小龙。"
    },
    {
      "id": "AD18",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.020770833333333332,
      "duration": 4.922395833333334,
      "gain_db": -3.7218142458545818,
      "peak_dbfs": -5.3177472385205675,
      "target_active_rms_dbfs": -26.0,
      "text": "血泊映出她的脸，皱纹浮现，红发夹着灰白。"
    },
    {
      "id": "AD19",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.0226875,
      "duration": 1.8931041666666666,
      "gain_db": -6.178701205313947,
      "peak_dbfs": -6.575703206655832,
      "target_active_rms_dbfs": -26.0,
      "text": "她端详着自己的手。"
    },
    {
      "id": "AD20",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.0226875,
      "duration": 1.8254375,
      "gain_db": -5.027754668705873,
      "peak_dbfs": -5.557001142952499,
      "target_active_rms_dbfs": -24.5,
      "text": "她抬头望向洞顶。"
    },
    {
      "id": "AD21",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.0458125,
      "duration": 2.597958333333333,
      "gain_db": -5.773118688890012,
      "peak_dbfs": -6.210447163818914,
      "target_active_rms_dbfs": -26.0,
      "text": "大龙的眼睛，慢慢合上了。"
    },
    {
      "id": "AD22",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.0226875,
      "duration": 1.779375,
      "gain_db": -4.766774862863599,
      "peak_dbfs": -5.73427189175383,
      "target_active_rms_dbfs": -24.5,
      "text": "她转身奔向洞外。"
    },
    {
      "id": "AD23",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.0259375,
      "duration": 1.7128958333333333,
      "gain_db": -0.781314132093971,
      "peak_dbfs": -9.393784497339663,
      "target_active_rms_dbfs": -26.0,
      "text": "巨石封住了洞口。"
    },
    {
      "id": "AD24",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.050729166666666665,
      "duration": 3.8541666666666665,
      "gain_db": -4.90210148312258,
      "peak_dbfs": -5.546488444274886,
      "target_active_rms_dbfs": -26.0,
      "text": "洞外，她独自坐在崖边，低垂着头。"
    },
    {
      "id": "AD25",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.041291666666666664,
      "duration": 1.9074583333333333,
      "gain_db": -4.965166579947078,
      "peak_dbfs": -9.422399029830341,
      "target_active_rms_dbfs": -26.0,
      "text": "皮带被留在岩石上。"
    },
    {
      "id": "AD26",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.0226875,
      "duration": 3.1474583333333332,
      "gain_db": -5.684775533981382,
      "peak_dbfs": -6.208952422692226,
      "target_active_rms_dbfs": -26.0,
      "text": "她两手空空，朝山谷走去。"
    },
    {
      "id": "AD29",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.057166666666666664,
      "duration": 2.6608125,
      "gain_db": -3.9701729426790084,
      "peak_dbfs": -4.72286023015303,
      "target_active_rms_dbfs": -26.0,
      "text": "岩缝里，几朵白花低垂。"
    },
    {
      "id": "AD27",
      "voice": "V01",
      "time_stretch": 1.0,
      "trimmed_head_seconds": 0.042166666666666665,
      "duration": 3.8495416666666666,
      "gain_db": -4.0423769948473725,
      "peak_dbfs": -7.5902181856466076,
      "target_active_rms_dbfs": -26.0,
      "text": "幼龙从后面跃出，跟着她下了山坡。"
    }
  ]
}