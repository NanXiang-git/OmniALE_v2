[
  {
    "sid": "001",
    "role": "celia",
    "start": 3.2,
    "end": 4.3,
    "zh": "汤姆，你真混蛋。",
    "note": "冷冷地斥责，尾字咬住",
    "voice": "V03"
  },
  {
    "sid": "002",
    "role": "thom_young",
    "start": 4.5,
    "end": 6.95,
    "zh": "西莉亚，我们得追随热爱。",
    "note": "年轻，急于解释",
    "voice": "V02"
  },
  {
    "sid": "003",
    "role": "thom_young",
    "start": 7.28,
    "end": 9.98,
    "zh": "你爱机器人，我想在太空大展身手。",
    "note": "自信，越说越兴奋",
    "voice": "V02"
  },
  {
    "sid": "004",
    "role": "celia",
    "start": 10.42,
    "end": 14.32,
    "zh": "你就承认吧，你怕我的机械手。",
    "note": "质问，重音在怕",
    "voice": "V03"
  },
  {
    "sid": "005",
    "role": "thom_young",
    "start": 14.55,
    "end": 16.35,
    "zh": "我才没怕，我是……",
    "note": "否认，结巴，不补完",
    "voice": "V02"
  },
  {
    "sid": "006",
    "role": "thom_young",
    "start": 17.23,
    "end": 18.3,
    "zh": "好吧！行！",
    "note": "让步，突然放大",
    "voice": "V02"
  },
  {
    "sid": "007",
    "role": "thom_young",
    "start": 18.58,
    "end": 20.86,
    "zh": "我是怕！我做噩梦，被追着跑……",
    "note": "承认后急促辩解",
    "voice": "V02"
  },
  {
    "sid": "008",
    "role": "thom_young",
    "start": 20.82,
    "end": 22.43,
    "zh": "追我的是巨大的夺命机械爪！",
    "note": "夸张恐惧，延续上一句",
    "voice": "V02"
  },
  {
    "sid": "009",
    "role": "celia",
    "start": 22.46,
    "end": 24.95,
    "zh": "随你吧，汤姆。我们完了。",
    "note": "冷漠，决绝",
    "voice": "V03"
  },
  {
    "sid": "010",
    "role": "operator",
    "start": 30.12,
    "end": 33.55,
    "zh": "机器人记忆已同步，已锁定！",
    "note": "技术员向全场报状态，清楚分开两个完成状态",
    "voice": "V07"
  },
  {
    "sid": "011",
    "role": "captain",
    "start": 40.75,
    "end": 42.3,
    "zh": "这可真够吓人的。",
    "note": "看着脑组织，低声",
    "voice": "V04"
  },
  {
    "sid": "012",
    "role": "barley",
    "start": 97.15,
    "end": 98.65,
    "zh": "你不该下去吗？",
    "note": "窗边画外问老汤姆",
    "voice": "V08"
  },
  {
    "sid": "013",
    "role": "barley",
    "start": 111.12,
    "end": 112.85,
    "zh": "昨晚我听见你们谈话了。",
    "note": "平静追问",
    "voice": "V08"
  },
  {
    "sid": "014",
    "role": "thom_older",
    "start": 116.0,
    "end": 117.75,
    "zh": "这可不是我的错。",
    "note": "苍老，带辩解",
    "voice": "V05"
  },
  {
    "sid": "015",
    "role": "captain",
    "start": 171.44,
    "end": 172.08,
    "zh": "准备好了吗？",
    "note": "询问老汤姆",
    "voice": "V04"
  },
  {
    "sid": "016",
    "role": "captain",
    "start": 172.52,
    "end": 174.55,
    "zh": "当然好了，你可是大明星。",
    "note": "鼓劲，略带戏谑",
    "voice": "V04"
  },
  {
    "sid": "017",
    "role": "captain",
    "start": 176.8,
    "end": 178.15,
    "zh": "巴利，情况如何？",
    "note": "对通讯器发问",
    "voice": "V04"
  },
  {
    "sid": "018",
    "role": "barley",
    "start": 178.6,
    "end": 180.42,
    "zh": "大概还有十分钟。",
    "note": "通讯，估计语气",
    "voice": "V08"
  },
  {
    "sid": "019",
    "role": "captain",
    "start": 181.35,
    "end": 182.65,
    "zh": "那就太好了。",
    "note": "轻快拍板",
    "voice": "V04"
  },
  {
    "sid": "020",
    "role": "captain",
    "start": 183.42,
    "end": 187.4,
    "zh": "一分钟后开场！各系统就位！对，你，快去！",
    "note": "指挥全场，最后转向具体人",
    "voice": "V04"
  },
  {
    "sid": "021",
    "role": "captain",
    "start": 187.88,
    "end": 192.1,
    "zh": "快！都动起来！快快快！",
    "note": "吼，催促",
    "voice": "V04"
  },
  {
    "sid": "022",
    "role": "captain",
    "start": 192.84,
    "end": 196.6,
    "zh": "太棒了！来，快！",
    "note": "兴奋，大声",
    "voice": "V04"
  },
  {
    "sid": "023",
    "role": "captain",
    "start": 202.63,
    "end": 203.64,
    "zh": "真不错。",
    "note": "满意",
    "voice": "V04"
  },
  {
    "sid": "024",
    "role": "captain",
    "start": 204.24,
    "end": 205.6,
    "zh": "没什么好担心的。",
    "note": "安抚",
    "voice": "V04"
  },
  {
    "sid": "025",
    "role": "captain",
    "start": 210.46,
    "end": 211.0,
    "zh": "汤姆。",
    "note": "叫住，停顿",
    "voice": "V04"
  },
  {
    "sid": "026",
    "role": "captain",
    "start": 211.47,
    "end": 212.85,
    "zh": "她就在那儿。",
    "note": "指向幻景",
    "voice": "V04"
  },
  {
    "sid": "027",
    "role": "captain",
    "start": 213.55,
    "end": 214.2,
    "zh": "现在。",
    "note": "转入指导",
    "voice": "V04"
  },
  {
    "sid": "028",
    "role": "captain",
    "start": 215.02,
    "end": 216.25,
    "zh": "你爱她。",
    "note": "耐心强调",
    "voice": "V04"
  },
  {
    "sid": "029",
    "role": "captain",
    "start": 217.35,
    "end": 218.45,
    "zh": "她就是你的热爱！",
    "note": "带表演指导的鼓动",
    "voice": "V04"
  },
  {
    "sid": "030",
    "role": "captain",
    "start": 219.02,
    "end": 220.65,
    "zh": "对她温柔点。",
    "note": "轻声指导",
    "voice": "V04"
  },
  {
    "sid": "031",
    "role": "captain",
    "start": 221.25,
    "end": 224.3,
    "zh": "要诚恳！呃，要温柔。",
    "note": "说诚恳后自我修正，保留呃与停顿",
    "voice": "V04"
  },
  {
    "sid": "032",
    "role": "captain",
    "start": 225.35,
    "end": 228.03,
    "zh": "让她想起，什么是爱。",
    "note": "郑重，对象为她",
    "voice": "V04"
  },
  {
    "sid": "033",
    "role": "captain",
    "start": 273.0,
    "end": 274.75,
    "zh": "预备，开拍！",
    "note": "发令",
    "voice": "V04"
  },
  {
    "sid": "034",
    "role": "operator",
    "start": 276.78,
    "end": 278.18,
    "zh": "记忆覆写进行中！",
    "note": "技术状态，尚未完成",
    "voice": "V07"
  },
  {
    "sid": "035",
    "role": "celia",
    "start": 279.15,
    "end": 280.55,
    "zh": "汤姆，你真混蛋！",
    "note": "重演，同一句更激烈",
    "voice": "V03"
  },
  {
    "sid": "036",
    "role": "operator",
    "start": 281.75,
    "end": 284.1,
    "zh": "哦，对不起！对不起。",
    "note": "误触后的慌乱，第二次更短",
    "voice": "V07"
  },
  {
    "sid": "037",
    "role": "thom_older",
    "start": 295.9,
    "end": 296.75,
    "zh": "西莉亚。",
    "note": "老汤姆的记忆重演／投影中仍为老年声线；重演，迟疑地开口",
    "voice": "V05",
    "raw_pitch_correction": 0.88
  },
  {
    "sid": "038",
    "role": "thom_older",
    "start": 297.89,
    "end": 300.15,
    "zh": "我们得追随热爱。",
    "note": "老汤姆的记忆重演／投影中仍为老年声线；比第一次更慢，试探",
    "voice": "V05",
    "raw_pitch_correction": 0.88
  },
  {
    "sid": "039",
    "role": "thom_older",
    "start": 300.95,
    "end": 302.48,
    "zh": "你爱机器人……",
    "note": "老汤姆的记忆重演／投影中仍为老年声线；尴尬，拖尾",
    "voice": "V05",
    "raw_pitch_correction": 0.88
  },
  {
    "sid": "040",
    "role": "thom_older",
    "start": 305.6,
    "end": 307.62,
    "zh": "我想在太空大展身手。",
    "note": "老汤姆的记忆重演／投影中仍为老年声线；重复但刻意，收住兴奋",
    "voice": "V05",
    "raw_pitch_correction": 0.88
  },
  {
    "sid": "041",
    "role": "barley",
    "start": 319.0,
    "end": 321.12,
    "zh": "他们来了，只剩两分钟！",
    "note": "紧张，通讯清晰突出数字",
    "voice": "V08"
  },
  {
    "sid": "042",
    "role": "captain",
    "start": 322.75,
    "end": 323.75,
    "zh": "汤姆，快点！",
    "note": "催促汤姆",
    "voice": "V04"
  },
  {
    "sid": "043",
    "role": "captain",
    "start": 324.7,
    "end": 325.98,
    "zh": "再快一点！",
    "note": "音乐术语的催促意味",
    "voice": "V04"
  },
  {
    "sid": "044",
    "role": "celia",
    "start": 326.53,
    "end": 330.08,
    "zh": "你就承认吧，你怕我的机械手。",
    "note": "同一句质问再次发生，更逼迫",
    "voice": "V03"
  },
  {
    "sid": "045",
    "role": "thom_older",
    "start": 336.52,
    "end": 338.9,
    "zh": "听我说，西莉亚。我那时年轻……",
    "note": "老汤姆的记忆重演／投影中仍为老年声线；认真承认，语气沉下来",
    "voice": "V05",
    "raw_pitch_correction": 0.88
  },
  {
    "sid": "046",
    "role": "thom_older",
    "start": 339.0,
    "end": 340.5,
    "zh": "又混蛋。",
    "note": "老汤姆的记忆重演／投影中仍为老年声线；自责，承接年轻",
    "voice": "V05",
    "raw_pitch_correction": 0.88
  },
  {
    "sid": "047",
    "role": "thom_older",
    "start": 341.0,
    "end": 342.95,
    "zh": "可这不是毁灭世界的理由。",
    "note": "老汤姆的记忆重演／投影中仍为老年声线；辩解，不能省掉否定",
    "voice": "V05",
    "raw_pitch_correction": 0.88
  },
  {
    "sid": "048",
    "role": "assistant",
    "start": 344.58,
    "end": 345.85,
    "zh": "他干嘛这样？",
    "note": "不解，指汤姆偏离剧本",
    "voice": "V06"
  },
  {
    "sid": "049",
    "role": "captain",
    "start": 346.6,
    "end": 348.45,
    "zh": "这招我们已经试过了！",
    "note": "不耐，提醒失败经验",
    "voice": "V04"
  },
  {
    "sid": "050",
    "role": "assistant",
    "start": 351.1,
    "end": 352.45,
    "zh": "中止！",
    "note": "急切命令",
    "voice": "V06"
  },
  {
    "sid": "051",
    "role": "captain",
    "start": 353.05,
    "end": 353.8,
    "zh": "停拍！",
    "note": "跟着发出停拍指令",
    "voice": "V04"
  },
  {
    "sid": "052",
    "role": "operator",
    "start": 354.05,
    "end": 356.2,
    "zh": "哇——！",
    "note": "慌张的非语言惊呼",
    "voice": "V07"
  },
  {
    "sid": "053",
    "role": "operator",
    "start": 357.18,
    "end": 358.5,
    "zh": "哇——！",
    "note": "再次惊呼，独立重制",
    "voice": "V07"
  },
  {
    "sid": "054",
    "role": "operator",
    "start": 359.02,
    "end": 362.35,
    "zh": "不要——！",
    "note": "拉长，绝望，不吞掉否定",
    "voice": "V07"
  },
  {
    "sid": "055",
    "role": "celia",
    "start": 363.3,
    "end": 364.95,
    "zh": "你伤透了我的心。",
    "note": "受伤，低沉",
    "voice": "V03"
  },
  {
    "sid": "056",
    "role": "thom_older",
    "start": 365.88,
    "end": 366.56,
    "zh": "我知道。",
    "note": "老汤姆的记忆重演／投影中仍为老年声线；短答，不争辩",
    "voice": "V05",
    "raw_pitch_correction": 0.88
  },
  {
    "sid": "057",
    "role": "celia",
    "start": 366.78,
    "end": 368.63,
    "zh": "你把我忘在了地球。",
    "note": "指控，强调遗弃",
    "voice": "V03"
  },
  {
    "sid": "058",
    "role": "thom_older",
    "start": 369.22,
    "end": 369.95,
    "zh": "我知道。",
    "note": "老汤姆的记忆重演／投影中仍为老年声线；又一次短答，更弱",
    "voice": "V05",
    "raw_pitch_correction": 0.88
  },
  {
    "sid": "059",
    "role": "celia",
    "start": 370.17,
    "end": 372.2,
    "zh": "我真该捏碎你。",
    "note": "威胁，抑制怒气",
    "voice": "V03"
  },
  {
    "sid": "060",
    "role": "thom_older",
    "start": 376.78,
    "end": 377.65,
    "zh": "我……",
    "note": "老汤姆的记忆重演／投影中仍为老年声线；被卡住，不补全",
    "voice": "V05",
    "raw_pitch_correction": 0.88
  },
  {
    "sid": "061",
    "role": "thom_older",
    "start": 386.7,
    "end": 388.28,
    "zh": "对不起。",
    "note": "老汤姆的记忆重演／投影中仍为老年声线；挣扎很久后的真诚道歉",
    "voice": "V05",
    "raw_pitch_correction": 0.88
  },
  {
    "sid": "062",
    "role": "captain",
    "start": 390.2,
    "end": 391.1,
    "zh": "临场发挥得好。",
    "note": "带欣赏的低声",
    "voice": "V04"
  },
  {
    "sid": "063",
    "role": "operator",
    "start": 399.2,
    "end": 400.02,
    "zh": "不是我的错！",
    "note": "急于推脱",
    "voice": "V07"
  },
  {
    "sid": "064",
    "role": "operator",
    "start": 402.12,
    "end": 402.83,
    "zh": "这回不是。",
    "note": "后置限定，仅限定这一次",
    "voice": "V07"
  },
  {
    "sid": "065",
    "role": "captain",
    "start": 408.4,
    "end": 409.48,
    "zh": "片场肃静！",
    "note": "画外，仍执着于拍摄",
    "voice": "V04"
  },
  {
    "sid": "066",
    "role": "barley",
    "start": 410.0,
    "end": 411.42,
    "zh": "没时间了！",
    "note": "迫切",
    "voice": "V08"
  },
  {
    "sid": "067",
    "role": "barley",
    "start": 464.55,
    "end": 465.4,
    "zh": "快呀！",
    "note": "冲出去前催促",
    "voice": "V08"
  },
  {
    "sid": "068",
    "role": "barley",
    "start": 480.82,
    "end": 483.4,
    "zh": "啊——！",
    "note": "战斗中非语言吼叫",
    "voice": "V08"
  },
  {
    "sid": "069",
    "role": "operator",
    "start": 483.72,
    "end": 485.67,
    "zh": "记忆覆写，百分之九十！",
    "note": "仅百分之九十，尚未完成",
    "voice": "V07"
  },
  {
    "sid": "070",
    "role": "assistant",
    "start": 486.24,
    "end": 488.25,
    "zh": "队长！必须中止！",
    "note": "面对队长明确要求中止",
    "voice": "V06"
  },
  {
    "sid": "071",
    "role": "thom_older",
    "start": 498.55,
    "end": 500.62,
    "zh": "世界变了，西莉亚……",
    "note": "老汤姆的记忆重演／投影中仍为老年声线；真诚，放慢",
    "voice": "V05",
    "raw_pitch_correction": 0.88
  },
  {
    "sid": "072",
    "role": "thom_older",
    "start": 514.56,
    "end": 516.1,
    "zh": "也许我们也能改变。",
    "note": "老汤姆的记忆重演／投影中仍为老年声线；轻而坚定",
    "voice": "V05",
    "raw_pitch_correction": 0.88
  },
  {
