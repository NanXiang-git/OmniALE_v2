{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "file_schemas": {
    "description_plan.json": {
      "type": "object",
      "properties": {
        "cues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              },
              "wav": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "start",
              "end",
              "wav"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "cues"
      ],
      "additionalProperties": true
    },
    "timeline.json": {
      "type": "object",
      "properties": {
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "source",
                  "hold"
                ]
              },
              "output_start": {
                "type": "number"
              },
              "output_end": {
                "type": "number"
              },
              "source_start": {
                "type": "number"
              },
              "source_end": {
                "type": "number"
              },
              "anchor_source_time": {
                "type": "number"
              }
            },
            "required": [
              "kind",
              "output_start",
              "output_end"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "segments"
      ],
      "additionalProperties": true
    },
    "chapters.json": {
      "type": "object",
      "properties": {
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "source_time": {
                "type": "number"
              },
              "output_time": {
                "type": "number"
              }
            },
            "required": [
              "title",
              "source_time",
              "output_time"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "chapters"
      ],
      "additionalProperties": true
    },
    "player_config.json": {
      "type": "object",
      "properties": {
        "tracks": {
          "type": "object",
          "properties": {
            "video": {
              "type": "string"
            },
            "base": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "video",
            "base",
            "description"
          ],
          "additionalProperties": true
        },
        "pause_policy": {
          "const": "fixed_timeline"
        }
      },
      "required": [
        "tracks",
        "pause_policy"
      ],
      "additionalProperties": true
    },
    "rebuild.json": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": true
    },
    "revision_audit.json": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "old_cue_id",
              "action",
              "new_cue_ids",
              "reason"
            ],
            "properties": {
              "old_cue_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "action": {
                "enum": [
                  "keep",
                  "rewrite",
                  "delete",
                  "merge"
                ]
              },
              "new_cue_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reason": {
                "type": "string",
                "minLength": 5
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}