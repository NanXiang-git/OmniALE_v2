{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "file_schemas": {
    "ad_plan.json": {
      "type": "object",
      "properties": {
        "cues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              },
              "wav": {
                "type": "string"
              },
              "visual_source_interval": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "knowledge_time": {
                "type": "number",
                "minimum": 0,
                "maximum": 264
              },
              "sound_risk": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "start",
              "end",
              "wav",
              "visual_source_interval",
              "knowledge_time",
              "sound_risk"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "cues"
      ],
      "additionalProperties": true
    },
    "player_config.json": {
      "type": "object",
      "properties": {
        "tracks": {
          "type": "object",
          "properties": {
            "video": {
              "type": "string"
            },
            "base": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "video",
            "base",
            "description"
          ],
          "additionalProperties": true
        },
        "pause_policy": {
          "const": "fixed_timeline"
        },
        "base_gain_db": {
          "type": "number",
          "minimum": -6,
          "maximum": 0
        }
      },
      "required": [
        "tracks",
        "pause_policy",
        "base_gain_db"
      ],
      "additionalProperties": true
    },
    "rebuild.json": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": true
    },
    "selection_audit.json": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "required": [
              "id",
              "visual_interval",
              "decision",
              "cue_ids",
              "reason",
              "earliest_knowable",
              "sound_risk_intervals"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "visual_interval": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 264
                },
                "minItems": 2,
                "maxItems": 2
              },
              "decision": {
                "enum": [
                  "describe",
                  "omit"
                ]
              },
              "cue_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "earliest_knowable": {
                "type": "number",
                "minimum": 0,
                "maximum": 264
              },
              "sound_risk_intervals": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 264
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        }
      }
    }
  }
}